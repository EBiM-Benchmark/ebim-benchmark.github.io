node_modules/
_site/

# Playwright MCP scratch output (page snapshots, console logs, screenshots).
# Written into the repo root when the navbar/layout is measured in a real
# browser; never part of the site.
.playwright-mcp/

# Python bytecode cache. scripts/*.py are run directly (which creates none), but
# importing one — or a py_compile check — writes __pycache__ beside the source.
__pycache__/
*.pyc

# Claude Code per-machine settings (local permissions, the C:\src\EBiM add-dir
# bridge). Tracked here rather than in .git/info/exclude because that file is
# never cloned: every fresh clone made for a verification session would otherwise
# see this as untracked and be one `git add -A` away from committing one
# machine's paths. Only the .local.json is ignored — .claude/settings.json is the
# shared project config and stays committable.
.claude/settings.local.json
