# Normalize line endings. Without this, eol behaviour depends on each contributor's
# local core.autocrlf setting: a Windows checkout produces CRLF working files while
# the index stays LF, so byte-level measurements of text files disagree with what CI
# builds and Pages serves. `text=auto` lets git detect binaries, so images and fonts
# are untouched.
* text=auto eol=lf

# Explicitly binary — never normalize, never diff as text.
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.ico  binary
*.woff2 binary
# PDFs are served verbatim as citable artifacts, so never normalize them. Left to
# text=auto, the decision rides on whether the file happens to contain a NUL byte
# anywhere in it — true of today's Rulebook, but not guaranteed of a future
# revision, and a CRLF-normalized PDF is a corrupted one.
*.pdf  binary
