{% raw %}
  <style>
    /* Back to top */
    #back-to-top {
      position: fixed; bottom: 2rem; right: 1.5rem; width: 44px; height: 44px; border-radius: 50%;
      background: var(--accent, #00d4ff); color: #0a0e1a; border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden; transform: translateY(12px);
      transition: opacity .3s, visibility .3s, transform .3s, background .2s, box-shadow .2s;
      z-index: 998; box-shadow: 0 4px 18px rgba(0,212,255,.35);
    }
    #back-to-top.visible { opacity: 1; visibility: visible; transform: none; }
    #back-to-top:hover { background: #fff; box-shadow: 0 6px 24px rgba(0,212,255,.45); }
    #back-to-top:focus-visible { outline: 2px solid #00d4ff; outline-offset: 3px; }
    #back-to-top svg { pointer-events: none; }

    /* ── Sub-page hero (copied from compute-apply.njk) ── */
    #home.subhero {
      min-height: 28vh; display: flex; align-items: center; justify-content: center;
      position: relative; background: var(--bg-dark); overflow: hidden;
      padding: calc(var(--nav-h) + 2.5rem) 0 3rem; box-sizing: border-box;
    }
    #home.subhero::before {
      content: ''; position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,212,255,.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,212,255,.07) 1px, transparent 1px);
      background-size: 60px 60px; pointer-events: none;
    }
    #home.subhero::after {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(0,212,255,.10) 0%, transparent 70%);
      pointer-events: none;
    }
    .subhero-content { position: relative; z-index: 1; text-align: center; max-width: 820px; padding: 1.25rem 1.5rem; }
    .subhero-title { font-size: clamp(1.7rem, 3.6vw, 2.6rem); color: #fff; font-weight: 800; line-height: 1.18; margin-bottom: .9rem; letter-spacing: -.01em; }
    .subhero-subtitle { font-size: clamp(.95rem, 1.6vw, 1.1rem); color: rgba(255,255,255,.72); margin: 0 auto; max-width: 620px; }
    @media (max-width: 700px) { #home.subhero { min-height: 32vh; padding-top: calc(var(--nav-h) + 1.5rem); padding-bottom: 2rem; } }

    /* ── Intro, language switch, closed line ──
       Secondary text on this page uses --text-mid (7.1:1 on the section's
       --bg-light, 7.5:1 on the white card), not --text-muted (2.4:1 / 2.6:1),
       so it passes WCAG AA. The .btn-submit rules below are
       the site's shared button style, copied unchanged. */
    .q-intro, .q-switch, .q-lang, .q-closed { max-width: 760px; margin: 0 auto 1rem; color: var(--text-mid); font-size: .98rem; line-height: 1.65; }
    .q-switch { font-size: .9rem; color: var(--text-mid); margin-bottom: .5rem; }
    .q-lang { display: flex; gap: .4rem; margin-bottom: 1.75rem; }
    .q-lang-opt { font-size: .82rem; font-weight: 700; padding: .25rem .7rem; border-radius: 999px; border: 1px solid var(--border); color: var(--text-mid); }
    .q-lang-opt.is-active { background: var(--bg-dark); border-color: var(--bg-dark); color: #fff; }
    a.q-lang-opt:hover { border-color: var(--text-dark); color: var(--text-dark); }
    .q-closed { text-align: center; font-size: 1.05rem; color: var(--text-dark); padding: 2rem 0; }
    .q-closed:focus, .form-success:focus { outline: none; }

    /* ── Card + form (classes shared with compute-apply / register) ── */
    .reg-card { max-width: 760px; margin: 0 auto; background: var(--bg-white); border: 1px solid var(--border); border-radius: 16px; padding: 2.5rem 2.25rem; box-shadow: var(--card-shadow); }
    .reg-form { display: flex; flex-direction: column; gap: 1.6rem; }
    .form-field { display: flex; flex-direction: column; gap: .4rem; }
    .form-label { font-size: .92rem; font-weight: 700; color: var(--text-dark); letter-spacing: .005em; line-height: 1.45; }
    .form-input, .form-textarea {
      width: 100%; font-family: inherit; font-size: .95rem; color: var(--text-dark);
      background: var(--bg-light); border: 1px solid var(--border); border-radius: 8px;
      padding: .72rem .9rem; transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .form-input:focus, .form-textarea:focus {
      outline: none; border-color: var(--accent); background: var(--bg-white); box-shadow: 0 0 0 3px rgba(0,212,255,.16);
    }
    .form-textarea { resize: vertical; min-height: 120px; line-height: 1.6; }
    fieldset.form-field { border: 0; margin: 0; padding: 0; min-width: 0; }
    fieldset.form-field > legend { padding: 0; }
    .reg-checks { display: flex; flex-direction: column; gap: .55rem; margin-top: .5rem; }
    .reg-check { display: flex; align-items: flex-start; gap: .6rem; font-size: .92rem; color: var(--text-dark); line-height: 1.45; cursor: pointer; }
    .reg-check input[type="checkbox"], .reg-check input[type="radio"] { margin-top: .15rem; width: 1.05rem; height: 1.05rem; accent-color: var(--accent-dark); flex-shrink: 0; }

    /* ── Sections, numbers, scales ── */
    .q-section { display: flex; flex-direction: column; gap: 1.4rem; }
    .q-section + .q-section { border-top: 1px solid var(--border); padding-top: 1.6rem; }
    .q-section-title { font-size: 1.15rem; font-weight: 800; color: var(--text-dark); margin: 0; }
    .q-num { color: var(--text-mid); margin-right: .15rem; }
    /* Scales: one full-width row of equal cells, digit under its radio, so the first
       and last cells sit exactly above the end labels at every width. On phones the
       scale also spans the card's side padding, keeping each of the 11 targets at
       least 24px wide. */
    .q-scale { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: .3rem; margin-top: .5rem; }
    .q-scale-opt { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .15rem; font-size: .88rem; color: var(--text-dark); border: 1px solid var(--border); border-radius: 8px; padding: .35rem 0; cursor: pointer; }
    .q-scale-opt input { accent-color: var(--accent-dark); margin: 0; }
    .q-scale-ends { display: flex; justify-content: space-between; gap: 1rem; font-size: .8rem; color: var(--text-mid); }
    @media (max-width: 767px) {
      .q-scale { gap: .2rem; }
      .q-scale-opt { padding: .3rem 0; font-size: .82rem; }
    }
    @media (max-width: 540px) {
      .q-scale, .q-scale-ends { margin-left: -1.35rem; margin-right: -1.35rem; }
      .q-scale-ends { padding: 0 .5rem; }
      .q-scale { gap: 0; }
    }

    /* Submit button */
    .btn-submit { width: 100%; justify-content: center; background: var(--accent); color: var(--bg-dark); font-size: 1rem; padding: .95rem 2rem; margin-top: .25rem; }
    .btn-submit:hover:not(:disabled) { background: var(--accent-dark); color: #fff; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,212,255,.28); }
    .btn-submit:disabled { opacity: .65; cursor: not-allowed; }
    .btn-submit:focus-visible { outline: 2px solid var(--accent-dark); outline-offset: 3px; }

    /* Inline error + success (same structure/classes as compute-apply) */
    .form-error[hidden] { display: none; }
    .form-error { display: flex; align-items: flex-start; gap: .55rem; background: rgba(220,38,38,.07); border: 1px solid rgba(220,38,38,.3); color: #b91c1c; border-radius: 8px; padding: .75rem .9rem; font-size: .88rem; line-height: 1.5; }
    .form-error svg { flex-shrink: 0; margin-top: .1rem; }
    .form-error a { color: inherit; text-decoration: underline; }
    .form-success { text-align: center; padding: 1rem .5rem; }
    .form-success-icon { width: 64px; height: 64px; margin: 0 auto 1.25rem; border-radius: 50%; background: rgba(0,212,255,.12); border: 1px solid rgba(0,212,255,.4); color: var(--accent-dark); display: flex; align-items: center; justify-content: center; }
    .form-success p { color: var(--text-mid); font-size: 1rem; line-height: 1.65; max-width: 480px; margin: 0 auto; }

    .reg-noscript { max-width: 760px; margin: 1rem auto 0; text-align: center; font-size: .9rem; color: #b91c1c; }
    .reg-privacy { max-width: 760px; margin: 1.5rem auto 0; text-align: center; font-size: .82rem; color: var(--text-mid); line-height: 1.6; }
    @media (max-width: 540px) { .reg-card { padding: 1.75rem 1.35rem; } }
    /* Smallest phones: slimmer section and card sides so the 11-option scale keeps 24px targets. */
    @media (max-width: 360px) { #questionnaire .container { padding-left: 1rem; padding-right: 1rem; } .reg-card { padding-left: 1rem; padding-right: 1rem; } .q-scale, .q-scale-ends { margin-left: -1rem; margin-right: -1rem; } }
  </style>
{% endraw %}
