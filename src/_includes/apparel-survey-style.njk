{% raw %}
  <style>
    /* Back to top */
    #back-to-top {
      position: fixed; bottom: 2rem; right: 1.5rem; width: 44px; height: 44px; border-radius: 50%;
      background: var(--accent, #00d4ff); color: #0a0e1a; border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden; transform: translateY(12px);
      transition: opacity .3s, visibility .3s, transform .3s, background .2s, box-shadow .2s;
      z-index: 998; box-shadow: 0 4px 18px rgba(0,212,255,.35);
    }
    #back-to-top.visible { opacity: 1; visibility: visible; transform: none; }
    #back-to-top:hover { background: #fff; box-shadow: 0 6px 24px rgba(0,212,255,.45); }
    #back-to-top:focus-visible { outline: 2px solid #00d4ff; outline-offset: 3px; }
    #back-to-top svg { pointer-events: none; }

    /* ── Sub-page hero (copied from compute-apply.njk) ── */
    #home.subhero {
      min-height: 28vh; display: flex; align-items: center; justify-content: center;
      position: relative; background: var(--bg-dark); overflow: hidden;
      padding: calc(var(--nav-h) + 2.5rem) 0 3rem; box-sizing: border-box;
    }
    #home.subhero::before {
      content: ''; position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,212,255,.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,212,255,.07) 1px, transparent 1px);
      background-size: 60px 60px; pointer-events: none;
    }
    #home.subhero::after {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(0,212,255,.10) 0%, transparent 70%);
      pointer-events: none;
    }
    .subhero-content { position: relative; z-index: 1; text-align: center; max-width: 820px; padding: 1.25rem 1.5rem; }
    .subhero-title { font-size: clamp(1.7rem, 3.6vw, 2.6rem); color: #fff; font-weight: 800; line-height: 1.18; margin-bottom: .9rem; letter-spacing: -.01em; }
    .subhero-subtitle { font-size: clamp(.95rem, 1.6vw, 1.1rem); color: rgba(255,255,255,.72); margin: 0 auto; max-width: 620px; }
    @media (max-width: 700px) { #home.subhero { min-height: 32vh; padding-top: calc(var(--nav-h) + 1.5rem); padding-bottom: 2rem; } }

    /* ── Intro line ──
       Secondary text on this page uses --text-mid (7.1:1 on the section's
       --bg-light, 7.5:1 on the white card), not --text-muted (2.4:1 / 2.6:1),
       so it passes WCAG AA. The .btn-submit rules below are
       the site's shared button style, copied unchanged. */
    .q-intro { max-width: 760px; margin: 0 auto 1rem; color: var(--text-mid); font-size: .98rem; line-height: 1.65; }
    .q-intro a { color: inherit; text-decoration: underline; }

    /* ── Card + form (classes shared with compute-apply / register) ── */
    .reg-card { max-width: 760px; margin: 0 auto; background: var(--bg-white); border: 1px solid var(--border); border-radius: 16px; padding: 2.5rem 2.25rem; box-shadow: var(--card-shadow); }
    .reg-form { display: flex; flex-direction: column; gap: 1.6rem; }
    .form-field { display: flex; flex-direction: column; gap: .4rem; }
    .form-label { font-size: .92rem; font-weight: 700; color: var(--text-dark); letter-spacing: .005em; line-height: 1.45; }
    .form-input, .form-textarea {
      width: 100%; font-family: inherit; font-size: .95rem; color: var(--text-dark);
      background: var(--bg-light); border: 1px solid var(--border); border-radius: 8px;
      padding: .72rem .9rem; transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .form-input:focus, .form-textarea:focus {
      outline: none; border-color: var(--accent); background: var(--bg-white); box-shadow: 0 0 0 3px rgba(0,212,255,.16);
    }
    .form-textarea { resize: vertical; min-height: 120px; line-height: 1.6; }
    fieldset.form-field { border: 0; margin: 0; padding: 0; min-width: 0; }
    fieldset.form-field > legend { padding: 0; }
    .reg-checks { display: flex; flex-direction: column; gap: .55rem; margin-top: .5rem; }
    .reg-check { display: flex; align-items: flex-start; gap: .6rem; font-size: .92rem; color: var(--text-dark); line-height: 1.45; cursor: pointer; }
    .reg-check input[type="checkbox"], .reg-check input[type="radio"] { margin-top: .15rem; width: 1.05rem; height: 1.05rem; accent-color: var(--accent-dark); flex-shrink: 0; }


    /* ── Sections ── */
    .q-section { display: flex; flex-direction: column; gap: 1.4rem; }
    .q-section + .q-section { border-top: 1px solid var(--border); padding-top: 1.6rem; }
    .q-section-title { font-size: 1.15rem; font-weight: 800; color: var(--text-dark); margin: 0; }

    /* Submit button */
    .btn-submit { width: 100%; justify-content: center; background: var(--accent); color: var(--bg-dark); font-size: 1rem; padding: .95rem 2rem; margin-top: .25rem; }
    .btn-submit:hover:not(:disabled) { background: var(--accent-dark); color: #fff; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,212,255,.28); }
    .btn-submit:disabled { opacity: .65; cursor: not-allowed; }
    .btn-submit:focus-visible { outline: 2px solid var(--accent-dark); outline-offset: 3px; }

    /* Inline error + success (same structure/classes as compute-apply) */
    .form-error[hidden] { display: none; }
    .form-error { display: flex; align-items: flex-start; gap: .55rem; background: rgba(220,38,38,.07); border: 1px solid rgba(220,38,38,.3); color: #b91c1c; border-radius: 8px; padding: .75rem .9rem; font-size: .88rem; line-height: 1.5; }
    .form-error svg { flex-shrink: 0; margin-top: .1rem; }
    .form-error a { color: inherit; text-decoration: underline; }
    .form-success { text-align: center; padding: 1rem .5rem; }
    .form-success-icon { width: 64px; height: 64px; margin: 0 auto 1.25rem; border-radius: 50%; background: rgba(0,212,255,.12); border: 1px solid rgba(0,212,255,.4); color: var(--accent-dark); display: flex; align-items: center; justify-content: center; }
    .form-success p { color: var(--text-mid); font-size: 1rem; line-height: 1.65; max-width: 480px; margin: 0 auto; }

    .reg-noscript { max-width: 760px; margin: 1rem auto 0; text-align: center; font-size: .9rem; color: #b91c1c; }
    .reg-privacy { max-width: 760px; margin: 1.5rem auto 0; text-align: center; font-size: .82rem; color: var(--text-mid); line-height: 1.6; }
    @media (max-width: 540px) { .reg-card { padding: 1.75rem 1.35rem; } }
    /* ── Apparel survey additions (page-local; style.css untouched) ── */
    .q-note { margin: 0; color: var(--text-mid); font-size: .92rem; line-height: 1.6; }
    .q-note strong { color: var(--text-dark); }
    .q-callout { margin: 0; background: rgba(0,212,255,.07); border-left: 3px solid var(--accent-dark); border-radius: 0 8px 8px 0; padding: .75rem 1rem; color: var(--text-mid); font-size: .92rem; line-height: 1.6; }
    .q-callout strong { color: var(--text-dark); }
    .q-sub-title { font-size: 1rem; font-weight: 800; color: var(--text-dark); margin: .4rem 0 0; }
    .q-req-msg { margin: -.1rem 0 0; color: #b91c1c; font-size: .85rem; line-height: 1.45; }
    .q-opt { font-weight: 400; color: var(--text-mid); }
    .q-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .q-row3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 640px) { .q-row, .q-row3 { grid-template-columns: 1fr; } }
    .form-select { width: 100%; font-family: inherit; font-size: .95rem; color: var(--text-dark); background: var(--bg-light); border: 1px solid var(--border); border-radius: 8px; padding: .7rem .8rem; }
    .form-select:focus { outline: none; border-color: var(--accent); background: var(--bg-white); box-shadow: 0 0 0 3px rgba(0,212,255,.16); }
    .is-invalid { border-color: #dc2626 !important; }

    /* Pill options (radios/checkboxes) with optional color swatch */
    .ap-pills { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .35rem; }
    .ap-pills label { display: inline-flex; align-items: center; gap: .5rem; border: 1px solid var(--border); border-radius: 999px; padding: .42rem .85rem; font-size: .92rem; color: var(--text-dark); background: var(--bg-white); cursor: pointer; }
    .ap-pills input { accent-color: var(--accent-dark); margin: 0; }
    .ap-pills label:has(input:checked) { border-color: var(--accent-dark); background: rgba(0,212,255,.08); box-shadow: 0 0 0 1px var(--accent-dark); }
    .ap-sw { width: 20px; height: 20px; border-radius: 50%; border: 1px solid rgba(0,0,0,.25); flex: none; }
    .ap-sw.none { background: repeating-linear-gradient(45deg, #fff 0 4px, #d5dae2 4px 8px); }
    .ap-sw.tip { width: 28px; height: 15px; border-radius: 4px; background: #111; position: relative; overflow: hidden; }
    .ap-sw.tip::after { content: ""; position: absolute; left: 0; right: 0; top: 5px; height: 4px; background: var(--c, transparent); }

    /* Text cards (radio + title + description) */
    .ap-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .65rem; margin-top: .35rem; }
    .ap-cards > label { display: flex; align-items: flex-start; gap: .6rem; border: 1px solid var(--border); border-radius: 10px; padding: .75rem .85rem; cursor: pointer; background: var(--bg-white); font-size: .92rem; color: var(--text-dark); line-height: 1.45; }
    .ap-cards > label input { accent-color: var(--accent-dark); margin-top: .2rem; flex: none; }
    .ap-cards > label:has(input:checked) { border-color: var(--accent-dark); background: rgba(0,212,255,.06); box-shadow: 0 0 0 1px var(--accent-dark); }
    .ap-cards small, .ap-tiles small { display: block; color: var(--text-mid); font-size: .84rem; margin-top: .15rem; }
    .ap-links { display: block; margin-top: .4rem; font-size: .84rem; color: var(--text-mid); }
    .ap-links a { color: var(--accent-dark); font-weight: 600; text-decoration: underline; }

    /* Picture tiles (polo logos, polo extras) */
    .ap-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: .65rem; margin-top: .35rem; }
    @media (max-width: 640px) { .ap-tiles { grid-template-columns: 1fr 1fr; } }
    .ap-tiles > figure, .ap-tiles > label { margin: 0; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--bg-white); display: flex; flex-direction: column; }
    .ap-tiles > label { cursor: pointer; }
    .ap-tiles > label:has(input:checked) { border-color: var(--accent-dark); box-shadow: 0 0 0 1px var(--accent-dark); background: rgba(0,212,255,.06); }
    .ap-tiles img, .ap-tile-blank { display: block; width: 100%; height: auto; min-height: 0; flex: none; aspect-ratio: 1 / 1; object-fit: cover; }
    .ap-tile-blank { display: flex; align-items: center; justify-content: center; background: var(--bg-light); color: var(--text-mid); font-weight: 600; font-size: .92rem; }
    .ap-tiles figcaption, .ap-tile-text { padding: .6rem .7rem; font-size: .9rem; color: var(--text-dark); line-height: 1.4; display: flex; gap: .45rem; align-items: flex-start; }
    .ap-tile-text input { accent-color: var(--accent-dark); margin-top: .2rem; flex: none; }
    .ap-num { display: inline-block; background: var(--bg-dark); color: #fff; font-weight: 700; font-size: .78rem; border-radius: 5px; padding: 0 .4rem; margin-right: .3rem; }

    /* Design gallery */
    .ap-designs { display: grid; gap: 1rem; }
    .ap-design { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: var(--bg-light); margin: 0; }
    .ap-design-imgs { display: grid; gap: 2px; background: var(--border); }
    .ap-design-imgs.two { grid-template-columns: 1fr 1fr; }
    .ap-design img { display: block; width: 100%; height: auto; }
    .ap-design figcaption { padding: .75rem .9rem; font-size: .92rem; color: var(--text-mid); line-height: 1.55; }
    .ap-design figcaption strong { color: var(--text-dark); }
    .ap-tag { display: inline-block; background: var(--bg-dark); color: #fff; font-weight: 800; border-radius: 6px; padding: 0 .55rem; margin-right: .45rem; }
    img.ap-zoom { cursor: zoom-in; }

    /* Rank selects */
    .ap-rank { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .ap-rank.two { grid-template-columns: 1fr 1fr; }
    @media (max-width: 640px) { .ap-rank, .ap-rank.two { grid-template-columns: 1fr; } }

    details.ap-how { font-size: .9rem; color: var(--text-mid); line-height: 1.6; }
    details.ap-how summary { cursor: pointer; font-weight: 600; color: var(--text-dark); }
    details.ap-how ul { margin: .4rem 0 0 1.1rem; padding: 0; }
    table.ap-sz { border-collapse: collapse; font-size: .85rem; margin-top: .5rem; }
    table.ap-sz th, table.ap-sz td { border: 1px solid var(--border); padding: .25rem .55rem; text-align: center; }

    /* Lightbox */
    .ap-lightbox { position: fixed; inset: 0; z-index: 1000; background: rgba(10,14,26,.92); display: none; align-items: center; justify-content: center; padding: 1rem; cursor: zoom-out; }
    .ap-lightbox.is-open { display: flex; }
    .ap-lightbox img { max-width: 100%; max-height: 100%; }
  </style>
{% endraw %}
