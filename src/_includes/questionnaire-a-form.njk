{#- Questionnaire A page body, shared by src/feedback-registered.njk (EN) and
    src/zh/feedback-registered.njk. Everything participant-facing comes from
    src/_data/questionnaireA.json in the page's own language (L); the field
    names, option codes, conditions and hidden values are language-neutral, so
    both pages submit the same fields by construction. The body starts hidden
    and is revealed by questionnaire-a-script.njk before the close time, so
    with JavaScript off only the noscript notice shows. -#}
{%- set Q = questionnaireA -%}
{%- set L = "zh" if lang == "zh" else "en" -%}
{%- set MAIL = "organizers@ebim-benchmark.org" -%}
{%- set MAILTO = '<a href="mailto:organizers@ebim-benchmark.org">organizers@ebim-benchmark.org</a>' -%}
{%- set counter = [] -%}
<main id="main-content">

<section id="home" class="subhero">
  <div class="subhero-content">
    <h1 class="subhero-title">{{ Q.text.title[L] | e }}</h1>
    <p class="subhero-subtitle">{{ Q.text.subtitle[L] | e }}</p>
  </div>
</section>

<section id="questionnaire">
  <div class="container">

    <noscript><p class="reg-noscript">{{ Q.text.noscript[L] | e | replace(MAIL, MAILTO) | safe }}</p></noscript>

    <p id="qClosed" class="q-closed" role="status" tabindex="-1" hidden>{{ Q.text.closed[L] | e }}</p>

    <div id="qBody" hidden>
      <p class="q-intro">{{ Q.text.intro[L] | e }}</p>
      <p class="q-switch">{{ Q.text.switchLine[L] | e | replace("中文", '<span lang="zh-Hans">中文</span>') | replace("English", '<span lang="en">English</span>') | safe }}</p>
      <p class="q-lang">
        {%- if L == "en" %}
        <span class="q-lang-opt is-active" lang="en" aria-current="true">EN</span>
        <a class="q-lang-opt" lang="zh-Hans" href="zh/feedback-registered.html">中文</a>
        {%- else %}
        <a class="q-lang-opt" lang="en" href="../feedback-registered.html">EN</a>
        <span class="q-lang-opt is-active" lang="zh-Hans" aria-current="true">中文</span>
        {%- endif %}
      </p>

      <div class="reg-card">
        <form id="qForm" data-closes-at="{{ Q.closesAt }}">
          <div class="reg-form">
{%- for s in Q.sections %}

            <div class="q-section">
              <h2 class="q-section-title">{{ s.title[L] | e }}</h2>
{%- for q in s.questions %}
{%- if q.options is string %}{% set opts = Q.optionSets[q.options] %}{% else %}{% set opts = q.options %}{% endif %}
{%- set cond = q.showIf %}
{%- if q.num %}{% set _n = counter.push(1) %}{% endif %}
{%- set numHtml %}{% if q.num %}<span class="q-num">{{ counter.length }}.</span> {% endif %}{% endset %}
              <div class="q" data-q="{{ q.name }}" data-type="{{ q.type }}"{% if cond %} data-show-if="{{ cond | dump | e }}" hidden{% endif %}>
{%- if q.type == "checkbox" or q.type == "radio" %}
                <fieldset class="form-field">
                  <legend class="form-label">{{ numHtml | safe }}{{ q.label[L] | e }}</legend>
                  <div class="reg-checks">
{%- for o in opts %}
                    <label class="reg-check"><input type="{{ q.type }}" name="{{ q.name }}" value="{{ o.code }}"{% if q.type == "checkbox" %} data-group{% endif %}{% if cond %} disabled{% endif %} /> <span>{{ o[L] | e }}</span></label>
{%- endfor %}
                  </div>
                </fieldset>
{%- elif q.type == "scale" %}
                <fieldset class="form-field" aria-describedby="{{ q.name }}_ends">
                  <legend class="form-label">{{ numHtml | safe }}{{ q.label[L] | e }}</legend>
                  <div class="q-scale">
{%- for v in range(q.min, q.max + 1) %}
                    <label class="q-scale-opt"><input type="radio" name="{{ q.name }}" value="{{ v }}" aria-describedby="{{ q.name }}_ends"{% if cond %} disabled{% endif %} /> <span>{{ v }}</span></label>
{%- endfor %}
                  </div>
                  <div class="q-scale-ends" id="{{ q.name }}_ends"><span>{{ q.minLabel[L] | e }}</span><span>{{ q.maxLabel[L] | e }}</span></div>
                </fieldset>
{%- elif q.type == "single" %}
{%- for o in opts %}
                <label class="reg-check"><input type="checkbox" name="{{ q.name }}" value="{{ o.code }}" data-group{% if cond %} disabled{% endif %} /> <span>{{ o[L] | e }}</span></label>
{%- endfor %}
{%- elif q.type == "longtext" %}
                <div class="form-field">
                  <label class="form-label" for="{{ q.name }}">{{ numHtml | safe }}{{ q.label[L] | e }}</label>
                  <textarea class="form-textarea" id="{{ q.name }}" name="{{ q.name }}" rows="4" maxlength="5000"{% if cond %} disabled{% endif %}></textarea>
                </div>
{%- else %}
                <div class="form-field">
                  <label class="form-label" for="{{ q.name }}">{{ numHtml | safe }}{{ q.label[L] | e }}</label>
                  <input class="form-input" type="{{ "email" if q.type == "email" else "text" }}" id="{{ q.name }}" name="{{ q.name }}" maxlength="{{ 200 if q.type == "email" else 500 }}"{% if q.type == "email" %} autocomplete="email"{% endif %}{% if cond %} disabled{% endif %} />
                </div>
{%- endif %}
              </div>
{%- endfor %}
            </div>
{%- endfor %}

            <input type="hidden" name="access_key" value="{{ Q.accessKey }}" />
            <input type="hidden" name="from_name" value="{{ Q.fromName | e }}" />
            <input type="hidden" name="subject" value="{{ Q.subject | e }}" />
            <input type="hidden" name="instrument" value="{{ Q.instrument }}" />
            <input type="hidden" name="lang" value="{{ L }}" />
            <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="h-captcha" data-captcha="true"></div>

            <div id="formError" class="form-error" role="alert" hidden>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span>{{ Q.text.error[L] | e | replace(MAIL, MAILTO) | safe }}</span>
            </div>

            <button type="submit" class="btn btn-submit"><span class="btn-label">{{ Q.text.submit[L] | e }}</span></button>
          </div>
        </form>

        <div id="formSuccess" class="form-success" role="status" tabindex="-1" hidden>
          <div class="form-success-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <p>{{ Q.text.thanks[L] | e }}</p>
        </div>
      </div>

      <p class="reg-privacy">{{ Q.text.privacy[L] | e }}</p>
    </div>

  </div>
</section>
</main>
