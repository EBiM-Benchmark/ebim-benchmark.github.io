<!-- ============================================================
     REGISTER — state-gated on site.openDayMunichRegistration
     ("open" → live RSVP form | "waitlist" → form + banner + list=waitlist
      | "closed" → no form, closed panel). See _data/site.json.
     This is the MUNICH key; site.openDayRegistration is Hamburg's and is not
     read here. The two days run on independent flags.
     ============================================================ -->
<section id="register">
  <div class="container">
    <div class="text-center fade-in">
      <h2 class="section-title">报名</h2>
    </div>

{%- if site.openDayMunichRegistration == "closed" %}

    <div class="od-closed fade-in">
      <div class="od-closed-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <h3>慕尼黑开放日的报名已截止。</h3>
      <p>如对本次活动有任何疑问，请<a href="{{ links.contact }}">与我们联系</a>。</p>
    </div>

{%- else %}

    <div class="od-notice fade-in">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
      <span>免费参加。班车共有 60 个席位，按报名先后分配——如果您报名时班车席位已满，我们仍非常欢迎您参加讲座与晚餐。报名将持续开放至 2026 年 9 月 10 日（周四）活动开始为止。请在出行前完成报名——我们无法接待未报名的到场者。您的席位以邮件确认为准；提交表单本身尚不代表席位已获保留。</span>
    </div>

    <div class="reg-card fade-in">

{%- if site.openDayMunichRegistration == "waitlist" %}
      <div class="od-waitlist">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span>班车的 60 个席位已全部预订。您仍可报名参加讲座与晚餐；如有席位空出，我们会通过邮件通知您。</span>
      </div>
{%- endif %}

      <!-- Native Web3Forms RSVP form. AJAX-first (see open-day-form-script.njk);
           hCaptcha is enabled on this key and enforced server-side, so JS is required to submit. -->
      <form id="openDayForm" action="https://api.web3forms.com/submit" method="POST"
            data-msg-referral="请至少选择一项了解本次开放日的渠道（或填写&quot;其他&quot;）。"
            data-msg-captcha="请先完成人机验证再提交。"
            data-msg-generic="出现了一些问题，请重试。"
            data-msg-network="网络错误——请稍后重试。"
            data-sending="提交中…"
            data-submit-label="确认报名">

        <div class="reg-form">

          <div class="form-field">
            <label class="form-label" for="full_name">姓名，须与您的带照片身份证件一致 <span class="req" aria-hidden="true">*</span>
              <span class="form-label-note">入口处会核对证件</span></label>
            <input class="form-input" type="text" id="full_name" name="full_name" maxlength="120" required placeholder="您的姓名" />
          </div>

          <div class="form-field">
            <label class="form-label" for="email">邮箱 <span class="req" aria-hidden="true">*</span>
              <span class="form-label-note">确认邮件将发送至此</span></label>
            <input class="form-input" type="email" id="email" name="email" maxlength="200" required placeholder="you@example.org" />
          </div>

          <div class="form-field">
            <label class="form-label" for="affiliation">所属单位（院校 / 公司） <span class="req" aria-hidden="true">*</span></label>
            <input class="form-input" type="text" id="affiliation" name="affiliation" maxlength="200" required placeholder="例如：慕尼黑工业大学" />
          </div>

          <div class="form-field">
            <label class="form-label" for="country">国家 <span class="req" aria-hidden="true">*</span></label>
            <input class="form-input" type="text" id="country" name="country" maxlength="120" required placeholder="例如：德国" />
          </div>

          <fieldset class="form-field">
            <legend class="form-label">您将如何参加上午的测试台参访？ <span class="req" aria-hidden="true">*</span></legend>
            <div class="od-radios">
              <label class="reg-check"><input type="radio" name="site_visit" value="Shuttle from Munich Hbf (10:00)" required /> <span>乘坐慕尼黑火车总站发车的班车（10:00）</span></label>
              <label class="reg-check"><input type="radio" name="site_visit" value="Shuttle from Agile Robots SE (10:30)" /> <span>乘坐 Agile Robots SE 发车的班车（10:30）</span></label>
              <label class="reg-check"><input type="radio" name="site_visit" value="I'll skip the site visit and come for the talks" /> <span>我不参加参访，只参加讲座</span></label>
            </div>
          </fieldset>

          <fieldset class="form-field">
            <legend class="form-label">您是否会留下参加在 Agile Robots SE 的晚餐？ <span class="req" aria-hidden="true">*</span>
              <span class="form-label-note">由 Agile Robots 招待，18:30 开始</span></legend>
            <div class="od-radios">
              <label class="reg-check"><input type="radio" name="dinner" value="Yes" required /> <span>是</span></label>
              <label class="reg-check"><input type="radio" name="dinner" value="No" /> <span>否</span></label>
            </div>
          </fieldset>

          <div class="form-field">
            <label class="form-label" for="dietary">饮食需求 <span class="form-label-note">（可选——午餐与晚餐均由主办方招待）</span></label>
            <input class="form-input" type="text" id="dietary" name="dietary" maxlength="200" placeholder="例如：素食、坚果过敏" />
          </div>

          <fieldset class="form-field">
            <legend class="form-label">您是通过什么渠道了解到本次开放日的？ <span class="req" aria-hidden="true">*</span></legend>
            <div class="reg-checks">
              <label class="reg-check"><input type="checkbox" name="referral" value="Discord" /> <span>Discord</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="WeChat" /> <span>微信</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="Colleague or word of mouth" /> <span>同事或口碑</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="X (Twitter)" /> <span>X（推特）</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="LinkedIn" /> <span>领英</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="Mailing list" /> <span>邮件列表</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="Search engine" /> <span>搜索引擎</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="The EBiM website" /> <span>EBiM 官网</span></label>
            </div>
            <input class="form-input reg-check-other" type="text" name="referral_other" maxlength="200" placeholder="其他（请注明）" />
          </fieldset>

          <!-- ── Consent ── -->
          <div class="form-field">
            <div class="reg-checks">
              <label class="reg-check">
                <input type="checkbox" name="consent_guestlist" value="Yes" required />
                <span>我同意将我的姓名与所属单位提供给 Agile Robots SE 用于办理入场。（必选——场地无法接待未在名单上的来宾。） <span class="req" aria-hidden="true">*</span></span>
              </label>
              <label class="reg-check">
                <input type="checkbox" name="consent_media_notice" value="Yes" required />
                <span>我了解本次活动将进行拍照与录像，相关影像可能由 EBiM 组织者及合作伙伴发布。 <span class="req" aria-hidden="true">*</span></span>
              </label>
              <label class="reg-check">
                <input type="checkbox" name="media_optout" value="Yes" />
                <span>请不要在公开发布的照片或录像中使用我的影像。</span>
              </label>
            </div>
          </div>

          <!-- Hidden Web3Forms fields -->
          <input type="hidden" name="access_key" value="c4af1beb-1263-4551-ba15-86647ce43ddb" />
          <input type="hidden" name="from_name" value="EBiM Benchmark — Open Day Munich" />
          <input type="hidden" name="subject" value="[OPEN DAY MUNICH] New registration" />
          <input type="hidden" name="redirect" value="https://ebim-benchmark.github.io/zh/open-day-munich-success.html" />
{%- if site.openDayMunichRegistration == "waitlist" %}
          <input type="hidden" name="list" value="waitlist" />
{%- endif %}

          <!-- Honeypot -->
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <!-- hCaptcha (zero-config via web3forms client script, loaded in trailingScripts) -->
          <div class="h-captcha" data-captcha="true"></div>

          <div id="formError" class="form-error" role="alert" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span id="formErrorText">出现了一些问题，请重试。</span>
          </div>

          <button type="submit" class="btn btn-submit">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11Z"/>
            </svg>
            <span class="btn-label">确认报名</span>
          </button>

          <noscript><p class="reg-noscript">完成报名需要启用 JavaScript（人机验证需要）。如无法启用，请发送邮件至 <a href="mailto:organizers@ebim-benchmark.org">organizers@ebim-benchmark.org</a>。</p></noscript>

        </div>
      </form>

      <div id="formSuccess" class="form-success" role="status" hidden>
        <div class="form-success-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <h2>感谢！</h2>
        <p>我们已收到您的报名。确认邮件随后发出；您的席位以我们的确认为准，请勿仅凭本页面安排行程。</p>
        <a href="index.html" class="btn btn-submit" style="max-width:240px;margin:0 auto;">返回首页</a>
      </div>

    </div>

    <p class="reg-privacy fade-in">我们仅将您的信息用于组织 EBiM 开放日——包括将您的姓名与所属单位提供给 Agile Robots SE 用于办理入场。我们不会出售这些信息，也不会将您加入任何邮件列表。表单由 Web3Forms 处理。</p>

{%- endif %}

    <p class="od-contact-line fade-in">
      EBiM Benchmark 在多个测试地点举办开放日。<a href="{{ links.openDay }}">查看全部开放日</a>，包括 2026 年 8 月 17 日的<a href="{{ links.openDayHamburg }}">汉堡开放日</a>与 2026 年 8 月 21 日的<a href="{{ links.openDayShanghai }}">上海开放日</a>。
    </p>

    <p class="od-contact-line fade-in">
      对开放日有疑问？<a href="{{ links.contact }}">与我们联系 <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

</main>
{% endblock %}

