            <tr class="is-prize"><td class="col-rank">2</td><th scope="row">HKUST-RockAI</th><td>第 2 名</td><td class="col-video"><a href="https://cloud.uni-hamburg.de/s/KbgEojL2QQTgA4R?dir=/HKUST-RockAI" target="_blank" rel="noopener" aria-label="观看 HKUST-RockAI 任务 2 评测录像">观看</a></td></tr>
            <tr class="is-prize"><td class="col-rank">3</td><th scope="row">Camelo</th><td>第 3 名</td><td class="col-video"><a href="https://cloud.uni-hamburg.de/s/KbgEojL2QQTgA4R?dir=/Camelo" target="_blank" rel="noopener" aria-label="观看 Camelo 任务 2 评测录像">观看</a></td></tr>
            <tr><td class="col-rank">4</td><th scope="row">StarCore SJTU</th><td>—</td><td class="col-video">—</td></tr>
