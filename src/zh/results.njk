{% block headStyle %}{% raw %}
  <style>
    .fade-in { opacity: 0; transform: translateY(20px); transition: opacity .55s ease, transform .55s ease; }
    .fade-in.visible { opacity: 1; transform: none; }

    /* Active nav link for the current page (Final Results, in the Competition dropdown) */
    .page-results .nav-dropdown a[href="results.html"] { color: var(--accent); font-weight: 700; }

    /* Back to top */
    #back-to-top {
      position: fixed; bottom: 2rem; right: 1.5rem; width: 44px; height: 44px; border-radius: 50%;
      background: var(--accent, #00d4ff); color: #0a0e1a; border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden; transform: translateY(12px);
      transition: opacity .3s, visibility .3s, transform .3s, background .2s, box-shadow .2s;
      z-index: 998; box-shadow: 0 4px 18px rgba(0,212,255,.35);
    }
    #back-to-top.visible { opacity: 1; visibility: visible; transform: none; }
    #back-to-top:hover { background: #fff; box-shadow: 0 6px 24px rgba(0,212,255,.45); }
    #back-to-top:focus-visible { outline: 2px solid #00d4ff; outline-offset: 3px; }
    #back-to-top svg { pointer-events: none; }

    /* ── Sub-page hero (copied from faq.njk — the global stylesheet has no .subhero/.breadcrumb) ── */
    #home.subhero {
      min-height: 32vh; display: flex; align-items: center; justify-content: center;
      position: relative; background: var(--bg-dark); overflow: hidden;
      padding: calc(var(--nav-h) + 2.5rem) 0 3rem; box-sizing: border-box;
    }
    #home.subhero::before {
      content: ''; position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,212,255,.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,212,255,.07) 1px, transparent 1px);
      background-size: 60px 60px; pointer-events: none;
    }
    #home.subhero::after {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(0,212,255,.10) 0%, transparent 70%);
      pointer-events: none;
    }
    .subhero-content { position: relative; z-index: 1; text-align: center; max-width: 820px; padding: 1.25rem 1.5rem; }
    .breadcrumb { display: inline-block; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.55); margin-bottom: 1rem; }
    .breadcrumb a { color: rgba(255,255,255,.55); transition: color .2s; }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb-sep { margin: 0 .55rem; opacity: .5; }
    .breadcrumb-current { color: var(--accent); }
    .subhero-title { font-size: clamp(1.7rem, 3.6vw, 2.6rem); color: #fff; font-weight: 800; line-height: 1.18; margin-bottom: .9rem; letter-spacing: -.01em; }
    .subhero-subtitle { font-size: clamp(.95rem, 1.6vw, 1.1rem); color: rgba(255,255,255,.72); margin-bottom: .8rem; max-width: 620px; margin-left: auto; margin-right: auto; }
    @media (max-width: 700px) { #home.subhero { min-height: 40vh; padding-top: calc(var(--nav-h) + 1.5rem); padding-bottom: 2rem; } }

    /* ── Final results: intro, per-task ranking tables, prizes, ranking method ── */
    #results { background: var(--bg-light); }
    #results .results-shell { max-width: 860px; margin: 0 auto; }
    #results .results-intro p { margin: 0 0 1rem; font-size: 1rem; line-height: 1.7; color: var(--text-mid); }
    #results .results-block { background: var(--bg-white); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--card-shadow); padding: 1.5rem 1.6rem; margin-top: 1.5rem; }
    #results .results-block h2 { font-size: 1.15rem; font-weight: 800; color: var(--text-dark); margin: 0 0 .75rem; text-align: left; }
    #results .results-block p { margin: 0 0 .9rem; font-size: .95rem; line-height: 1.65; color: var(--text-mid); }
    #results .results-block p:last-child { margin-bottom: 0; }
    #results .results-block ul { margin: 0 0 .9rem 1.2rem; padding: 0; font-size: .95rem; line-height: 1.65; color: var(--text-mid); }
    #results .results-block li { margin-bottom: .35rem; }
    #results .results-block p a { font-weight: 600; text-decoration: underline; }
    #results .results-table-wrap { overflow-x: auto; }
    #results table { width: 100%; border-collapse: collapse; font-size: .95rem; table-layout: fixed; }
    /* Shared column widths so the Task 2 and Task 3 tables line up */
    #results thead th:nth-child(1) { width: 4.5rem; }
    #results thead th:nth-child(2) { width: 38%; }
    #results thead th:nth-child(3) { width: 24%; }
    #results caption { caption-side: top; text-align: left; }
    #results th, #results td { padding: .65rem .75rem; text-align: left; border-bottom: 1px solid var(--border); vertical-align: middle; }
    #results thead th { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); font-weight: 700; white-space: nowrap; }
    #results tbody th { font-weight: 700; color: var(--text-dark); }
    #results tbody tr:last-child > * { border-bottom: 0; }
    #results .col-rank { font-variant-numeric: tabular-nums; font-weight: 800; color: var(--text-dark); }
    #results tr.is-prize .col-rank { color: var(--accent-dark); }
    #results .col-video a { font-weight: 600; border-bottom: 1px solid currentColor; }
    #results .col-video a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    @media (max-width: 700px) {
      #results .results-block { padding: 1.2rem 1rem; }
      #results th, #results td { padding: .55rem .4rem; }
      #results thead th { white-space: normal; letter-spacing: 0; font-size: .68rem; }
      #results thead th:nth-child(1) { width: 3.25rem; }
      #results thead th:nth-child(2) { width: 34%; }
      #results thead th:nth-child(3) { width: 20%; }
      #results tbody th { overflow-wrap: break-word; }
      #results .col-video a { white-space: nowrap; }
    }
    @media (max-width: 400px) {
      #results .results-block { padding: 1rem .6rem; }
      #results th, #results td { padding: .5rem .3rem; }
      #results thead th:nth-child(1) { width: 2.5rem; }
      #results thead th:nth-child(2) { width: 36%; }
      #results thead th:nth-child(3) { width: 19%; }
    }
  </style>
{% endraw %}{% endblock %}

