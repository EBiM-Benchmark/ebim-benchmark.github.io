              <a class="podium-video" href="https://cloud.uni-hamburg.de/s/KbgEojL2QQTgA4R?dir=/EDL%20Team_task3" target="_blank" rel="noopener" aria-label="观看 EDL Team 任务 3 评测录像"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>观看</a>
            </li>
          </ol>
