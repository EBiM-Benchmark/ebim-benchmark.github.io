              <div class="podium-team"><span class="team-name">rl_alpha</span><span class="team-place">第 1 名</span></div>
              <a class="podium-video" href="https://cloud.uni-hamburg.de/s/KbgEojL2QQTgA4R?dir=/rl_alpha" target="_blank" rel="noopener" aria-label="观看 rl_alpha 任务 3 评测录像"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>观看</a>
