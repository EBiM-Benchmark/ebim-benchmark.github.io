---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
# Locale-aware sitemap, gated PER PAGE on each locale's publish map in
# src/_data/site.json (zhPublished for /zh/, zhTwPublished for /zh-tw/). The
# rows are derived by the sitemapRows filter (lib/locales.mjs) from the 11 EN
# rows below: the 11 EN URLs are always listed; a /zh/ or /zh-tw/ URL is listed
# iff its pair's flag in that locale is true. A pair published in two or more
# locales carries the same alternates as its pages' hreflangAlternates on every
# one of its rows: each published locale (en, zh-Hans, zh-Hant), then x-default.
# Today all 11 /zh/ pairs are published and no /zh-tw/ pair is: 22 URLs
# (11 EN + 11 /zh/), each pair carrying en/zh-Hans/x-default alternates. With
# every zh-TW pair published too: 33 URLs (11 EN + 11 /zh/ + 11 /zh-tw/), each
# carrying en/zh-Hans/zh-Hant/x-default. (Return a flag to false and that row
# drops out and its pair's alternates shrink.) /zh/ rows reuse the EN lastmod;
# /zh-tw/ rows use localeLastmod["zh-tw"], the date the locale's chrome landed.
# The xhtml namespace is emitted whenever any pair has alternates. 404 /
# contact-success / register-success / open-day-success / open-day-munich-success
# / compute-apply / compute-success / contact-test / the feedback questionnaires
# (in every locale) are intentionally excluded.
sitemap:
  pages:
    - { pair: "index", lastmod: "2026-06-21", changefreq: "weekly", priority: "1.0" }
    - { pair: "competition", lastmod: "2026-06-21", changefreq: "weekly", priority: "0.9" }
    - { pair: "workshop", lastmod: "2026-06-15", changefreq: "weekly", priority: "0.9" }
    - { pair: "contact", lastmod: "2026-06-15", changefreq: "monthly", priority: "0.6" }
    - { pair: "register", lastmod: "2026-06-29", changefreq: "weekly", priority: "0.8" }
    - { pair: "faq", lastmod: "2026-07-01", changefreq: "monthly", priority: "0.6" }
    - { pair: "openDayHamburg", lastmod: "2026-07-15", changefreq: "weekly", priority: "0.8" }
    - { pair: "openDay", lastmod: "2026-08-02", changefreq: "weekly", priority: "0.8" }
    - { pair: "openDayShanghai", lastmod: "2026-08-02", changefreq: "weekly", priority: "0.8" }
    - { pair: "openDayMunich", lastmod: "2026-09-04", changefreq: "weekly", priority: "0.8" }
    - { pair: "results", lastmod: "2026-10-02", changefreq: "monthly", priority: "0.8" }
  localeLastmod:
    zh-tw: "2026-10-30"
---
<?xml version="1.0" encoding="UTF-8"?>
{%- set rows = sitemap.pages | sitemapRows(site, sitemap.localeLastmod) %}
{%- if rows | selectattr("hasAlternates") | length %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- else %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- endif %}
{%- for u in rows %}
  <url>
    <loc>{{ u.loc }}</loc>
    <lastmod>{{ u.lastmod }}</lastmod>
    <changefreq>{{ u.changefreq }}</changefreq>
    <priority>{{ u.priority }}</priority>
{%- for alt in u.alternates %}
    <xhtml:link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ alt.href }}" />
{%- endfor %}
  </url>
{%- endfor %}
</urlset>
