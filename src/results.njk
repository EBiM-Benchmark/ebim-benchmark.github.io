  <meta property="og:image:alt"   content="EBiM Benchmark — Toward a Globally Coordinated Benchmark for Real-World Embodied Bimanual Manipulation" />
  <meta property="og:locale"      content="en_US" />
  <!-- Twitter / X Card -->
  <meta name="twitter:card"        content="summary_large_image" />
