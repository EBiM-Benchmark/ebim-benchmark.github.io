{% endblock %}
{# NOTE: do NOT include jsonld.njk — results is not in the pageMeta/jsonLd whitelist, so the computed
   bundles are undefined for it and base.njk falls back to this front-matter title/description. #}

{% block headStyle %}{% raw %}
  <style>
    .fade-in { opacity: 0; transform: translateY(20px); transition: opacity .55s ease, transform .55s ease; }
    .fade-in.visible { opacity: 1; transform: none; }

    /* Active nav link for the current page (Final Results, in the Competition dropdown) */
    .page-results .nav-dropdown a[href="results.html"] { color: var(--accent); font-weight: 700; }

    /* Back to top */
    #back-to-top {
      position: fixed; bottom: 2rem; right: 1.5rem; width: 44px; height: 44px; border-radius: 50%;
      background: var(--accent, #00d4ff); color: #0a0e1a; border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden; transform: translateY(12px);
      transition: opacity .3s, visibility .3s, transform .3s, background .2s, box-shadow .2s;
      z-index: 998; box-shadow: 0 4px 18px rgba(0,212,255,.35);
    }
    #back-to-top.visible { opacity: 1; visibility: visible; transform: none; }
    #back-to-top:hover { background: #fff; box-shadow: 0 6px 24px rgba(0,212,255,.45); }
    #back-to-top:focus-visible { outline: 2px solid #00d4ff; outline-offset: 3px; }
    #back-to-top svg { pointer-events: none; }

    /* ── Sub-page hero (copied from faq.njk — the global stylesheet has no .subhero/.breadcrumb) ── */
    #home.subhero {
      min-height: 32vh; display: flex; align-items: center; justify-content: center;
      position: relative; background: var(--bg-dark); overflow: hidden;
      padding: calc(var(--nav-h) + 2.5rem) 0 3rem; box-sizing: border-box;
    }
    #home.subhero::before {
      content: ''; position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,212,255,.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,212,255,.07) 1px, transparent 1px);
      background-size: 60px 60px; pointer-events: none;
    }
    #home.subhero::after {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(0,212,255,.10) 0%, transparent 70%);
      pointer-events: none;
    }
    .subhero-content { position: relative; z-index: 1; text-align: center; max-width: 820px; padding: 1.25rem 1.5rem; }
    .breadcrumb { display: inline-block; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.55); margin-bottom: 1rem; }
    .breadcrumb a { color: rgba(255,255,255,.55); transition: color .2s; }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb-sep { margin: 0 .55rem; opacity: .5; }
    .breadcrumb-current { color: var(--accent); }
    .subhero-title { font-size: clamp(1.7rem, 3.6vw, 2.6rem); color: #fff; font-weight: 800; line-height: 1.18; margin-bottom: .9rem; letter-spacing: -.01em; }
    .subhero-subtitle { font-size: clamp(.95rem, 1.6vw, 1.1rem); color: rgba(255,255,255,.72); margin-bottom: .8rem; max-width: 620px; margin-left: auto; margin-right: auto; }
    @media (max-width: 700px) { #home.subhero { min-height: 40vh; padding-top: calc(var(--nav-h) + 1.5rem); padding-bottom: 2rem; } }

    /* ── Final results ─────────────────────────────────────────────────────
       One column (760px) for prose and cards alike, so every edge lines up.
       Each task carries its identity colour from the competition.html task
       cards (T1 cyan, T2 violet, T3 orange) on its icon tile, podium top bar
       and podium glow. Places 1–3 get a CSS medal; everything else is quiet. */
    .page-results .subhero-content { display: flex; flex-direction: column; align-items: center; }
    .page-results .hero-wordmark { margin-bottom: 1rem; }
    .page-results .breadcrumb { margin-bottom: 1.1rem; }

    #results {
      --t1-a: #0a2a4a; --t1-b: #00b4d8; --t1-ink: #0a7c95; --t1-glow: rgba(0,180,216,.20);
      --t2-a: #2d1b69; --t2-b: #c026d3; --t2-ink: #9333ea; --t2-glow: rgba(192,38,211,.22);
      --t3-a: #7c2d12; --t3-b: #f97316; --t3-ink: #c2410c; --t3-glow: rgba(249,115,22,.20);
      background: var(--bg-light);
    }
    #results .results-shell { max-width: 760px; margin: 0 auto; }
    #results .results-intro p { margin: 0 0 1rem; font-size: 1.06rem; line-height: 1.75; color: var(--text-mid); }
    #results .results-intro p:last-child { margin-bottom: 0; color: var(--text-dark); font-weight: 500; }

    /* Hero task jump links */
    .page-results .task-jump { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; margin-top: 1.4rem; list-style: none; padding: 0; }
    .page-results .task-jump a {
      display: inline-flex; align-items: center; gap: .55rem; padding: .35rem .9rem .35rem .4rem;
      border-radius: 999px; border: 1px solid rgba(255,255,255,.16); background: rgba(255,255,255,.04);
      color: rgba(255,255,255,.88); font-size: .9rem; font-weight: 600; text-decoration: none;
      transition: border-color .2s, background .2s;
    }
    .page-results .task-jump a:hover { border-color: rgba(0,212,255,.6); background: rgba(0,212,255,.08); }
    .page-results .task-jump a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .page-results .task-jump .task-ico { width: 1.75rem; height: 1.75rem; border-radius: 999px; }
    .page-results .task-jump .task-ico svg { width: 1rem; height: 1rem; }

    /* Icon tile, shared by headings, the Task 1 note and the hero links */
    .page-results .task-ico { display: inline-grid; place-items: center; flex: none; color: #fff; }
    .page-results .task-ico svg { display: block; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .page-results .ico-t1 { background: linear-gradient(135deg, var(--t1-a, #0a2a4a), var(--t1-b, #00b4d8)); }
    .page-results .ico-t2 { background: linear-gradient(135deg, var(--t2-a, #2d1b69), var(--t2-b, #c026d3)); }
    .page-results .ico-t3 { background: linear-gradient(135deg, var(--t3-a, #7c2d12), var(--t3-b, #f97316)); }

    /* Task headings */
    #results .task { margin-top: 3.5rem; scroll-margin-top: calc(var(--nav-h) + 1rem); }
    #results .task-head { display: flex; align-items: center; gap: 1rem; margin: 0 0 1.2rem; }
    #results .task-head .task-ico { width: 3.25rem; height: 3.25rem; border-radius: 14px; box-shadow: 0 8px 20px rgba(10,14,26,.15); }
    #results .task-head .task-ico svg { width: 1.7rem; height: 1.7rem; }
    #results .task-title { display: flex; flex-direction: column; gap: .2rem; margin: 0; text-align: left; }
    #results .task-num { font-size: .88rem; font-weight: 700; letter-spacing: .02em; }
    #task-1 .task-num { color: var(--t1-ink); }
    #task-2 .task-num { color: var(--t2-ink); }
    #task-3 .task-num { color: var(--t3-ink); }
    #results .task-sep { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    #results .task-name { font-size: clamp(1.35rem, 2.5vw, 1.75rem); font-weight: 800; line-height: 1.2; letter-spacing: -.015em; color: var(--text-dark); }

    /* Task 1: low-key note, icon desaturated */
    #results .task-note { margin-top: 2.75rem; padding: 1.15rem 1.25rem; border: 1px dashed #cbd5e1; border-radius: 14px; }
    #results .task-note .task-head { margin-bottom: .6rem; }
    #results .task-note .task-ico { width: 2.5rem; height: 2.5rem; border-radius: 11px; filter: saturate(.25); opacity: .75; box-shadow: none; }
    #results .task-note .task-ico svg { width: 1.3rem; height: 1.3rem; }
    #results .task-note .task-name { font-size: 1.1rem; }
    #results .task-note p { margin: 0; font-size: .95rem; line-height: 1.6; color: var(--text-mid); }

    /* Standings: dark podium + light field strip */
    #results .standings { border-radius: 16px; overflow: hidden; background: var(--bg-white); border: 1px solid var(--border); box-shadow: 0 20px 50px rgba(10,14,26,.16); }
    #results .podium { position: relative; list-style: none; margin: 0; padding: 1.35rem 1.1rem 1.1rem; display: flex; flex-direction: column; gap: .6rem; background: linear-gradient(160deg, #0f1629 0%, #0a0e1a 100%); }
    #results .podium::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 70% 70% at 95% -10%, var(--glow), transparent 70%); }
    #results .podium::after { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: linear-gradient(90deg, var(--bar-a), var(--bar-b)); }
    #task-2 .podium { --glow: var(--t2-glow); --bar-a: var(--t2-a); --bar-b: var(--t2-b); }
    #task-3 .podium { --glow: var(--t3-glow); --bar-a: var(--t3-a); --bar-b: var(--t3-b); }
    #results .podium-row { position: relative; display: grid; min-height: 4.6rem; grid-template-columns: 3.5rem 1fr auto; align-items: center; column-gap: 1rem; padding: .9rem 1.1rem .9rem .8rem; border-radius: 12px; background: rgba(255,255,255,.045); border: 1px solid rgba(255,255,255,.06); }
    #results .place-1 { padding-top: 1.2rem; padding-bottom: 1.2rem; background: linear-gradient(90deg, rgba(234,179,8,.10), rgba(255,255,255,.04) 60%); border-color: rgba(234,179,8,.28); }

    /* CSS medal: ribbon tails (task colour) behind a metallic disc. The
       numeral is decorative; the "1st place" text carries the meaning. */
    #results .medal { position: relative; justify-self: center; display: grid; place-items: center; width: 2.6rem; height: 2.6rem; }
    #results .medal::before, #results .medal::after { content: ''; position: absolute; top: 56%; width: .9rem; height: 1.9rem; background: var(--ribbon); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%); }
    #results .medal::before { left: 14%; transform: rotate(24deg); }
    #results .medal::after { right: 14%; transform: rotate(-24deg); filter: brightness(.78); }
    #task-2 .medal { --ribbon: #c026d3; }
    #task-3 .medal { --ribbon: #f97316; }
    #results .medal-disc { position: relative; z-index: 1; display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; font-size: 1.15rem; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; box-shadow: inset 0 0 0 2px rgba(255,255,255,.4), inset 0 -3px 6px rgba(0,0,0,.22), 0 6px 14px rgba(0,0,0,.35); }
    #results .place-1 .medal { width: 3.2rem; height: 3.2rem; }
    #results .place-1 .medal-disc { font-size: 1.4rem; color: #422006; background: radial-gradient(circle at 32% 28%, #fff3b0 0%, #facc15 38%, #ca8a04 100%); }
    #results .place-2 .medal-disc { color: #1e293b; background: radial-gradient(circle at 32% 28%, #ffffff 0%, #d7dee8 40%, #8e9aab 100%); }
    #results .place-3 .medal-disc { color: #fff; background: radial-gradient(circle at 32% 28%, #f6c08f 0%, #c46a26 42%, #7c3510 100%); text-shadow: 0 1px 1px rgba(0,0,0,.35); }

    #results .podium-team { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
    #results .podium .team-name { font-size: 1.3rem; font-weight: 800; color: #fff; line-height: 1.2; letter-spacing: -.01em; overflow-wrap: anywhere; }
    #results .place-1 .team-name { font-size: 1.6rem; }
    #results .team-place { font-size: .85rem; color: rgba(255,255,255,.62); }
    #results .place-1 .team-place { color: #facc15; font-weight: 600; }
    #results .podium-video { display: inline-flex; align-items: center; gap: .45rem; white-space: nowrap; padding: .5rem 1rem .5rem .8rem; border-radius: 999px; border: 1px solid rgba(0,212,255,.55); color: var(--accent); font-size: .9rem; font-weight: 600; text-decoration: none; transition: background .2s, color .2s, border-color .2s; }
    #results .podium-video svg { flex: none; }
    #results .podium-video:hover { background: var(--accent); color: #0a0e1a; border-color: var(--accent); }
    #results .podium-video:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

    #results .field { list-style: none; margin: 0; padding: .3rem 1.1rem .45rem; }
    #results .field li { display: grid; grid-template-columns: 3.5rem 1fr; column-gap: 1rem; align-items: center; padding: .7rem 0 .7rem .8rem; border-top: 1px solid var(--border); }
    #results .field li:first-child { border-top: 0; }
    #results .field-rank { justify-self: center; display: inline-grid; place-items: center; min-width: 1.9rem; height: 1.9rem; border-radius: 999px; background: #eef2f7; font-size: .88rem; font-weight: 700; color: #475569; font-variant-numeric: tabular-nums; }
    #results .field .team-name { font-weight: 600; color: var(--text-dark); overflow-wrap: anywhere; }

    /* Prizes and ranking method */
    #results .results-prose { margin-top: 3.75rem; padding-top: 2.25rem; border-top: 1px solid var(--border); }
    #results .results-prose + .results-prose { margin-top: 2.5rem; }
    #results .results-prose h2 { font-size: 1.3rem; font-weight: 800; color: var(--text-dark); margin: 0 0 .8rem; text-align: left; }
    #results .results-prose p { margin: 0 0 1rem; font-size: .98rem; line-height: 1.75; color: var(--text-mid); }
    #results .results-prose p:last-child { margin-bottom: 0; }
    #results .results-prose p a { color: var(--t1-ink); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
    #results .criteria { list-style: none; margin: 0 0 1.1rem; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; }
    #results .criteria li { padding: 1rem 1.1rem 1.05rem; border-radius: 14px; background: var(--bg-white); border: 1px solid var(--border); font-size: .94rem; line-height: 1.6; color: var(--text-mid); }
    #results .criteria-seq { display: flex; align-items: center; gap: .4rem; margin-bottom: .65rem; }
    #results .criteria-seq .c-ico { display: inline-grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 10px; }
    #results .criteria-seq svg { width: 1.2rem; height: 1.2rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    #results .criteria-seq .c-then { width: .9rem; height: .9rem; color: #94a3b8; }
    #results .crit-t2 .c-ico { background: rgba(192,38,211,.10); color: var(--t2-ink); }
    #results .crit-t3 .c-ico { background: rgba(249,115,22,.12); color: var(--t3-ink); }
    #results .crit-t2 { border-top: 3px solid var(--t2-b); }
    #results .crit-t3 { border-top: 3px solid var(--t3-b); }

    @media (max-width: 640px) {
      #results .task { margin-top: 2.75rem; }
      #results .task-head .task-ico { width: 2.75rem; height: 2.75rem; border-radius: 12px; }
      #results .task-head .task-ico svg { width: 1.45rem; height: 1.45rem; }
      #results .podium { padding: 1.1rem .7rem .7rem; }
      #results .podium-row { grid-template-columns: 2.8rem 1fr; row-gap: .7rem; column-gap: .75rem; padding: .85rem .85rem .85rem .6rem; }
      #results .medal { width: 2.2rem; height: 2.2rem; }
      #results .medal-disc { font-size: 1rem; }
      #results .place-1 .medal { width: 2.6rem; height: 2.6rem; }
      #results .place-1 .medal-disc { font-size: 1.2rem; }
      #results .podium .team-name { font-size: 1.15rem; }
      #results .place-1 .team-name { font-size: 1.35rem; }
      #results .podium-video { grid-column: 2; justify-self: start; }
      #results .field { padding: .25rem .7rem .4rem; }
      #results .field li { grid-template-columns: 2.8rem 1fr; column-gap: .75rem; padding-left: .6rem; }
      #results .criteria { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .fade-in { opacity: 1; transform: none; transition: none; }
      #results .podium-video, .page-results .task-jump a { transition: none; }
    }
  </style>
{% endraw %}{% endblock %}

{% block main %}{% raw %}
<main id="main-content">
<section id="home" class="subhero">
  <div class="subhero-content">
    <div class="hero-wordmark hero-wordmark-sm" role="img" aria-label="EBiM Benchmark">
      <span class="hero-wordmark-mark">EBiM</span><span class="hero-wordmark-sub">Benchmark</span>
    </div>
    <div class="breadcrumb" aria-label="Breadcrumb">
      <a href="index.html">Home</a>
      <span class="breadcrumb-sep">/</span>
      <a href="competition.html">Competition</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">Final Results</span>
    </div>
    <h1 class="subhero-title">Final Results</h1>
    <p class="subhero-subtitle">EBiM Benchmark Competition 2026</p>
    <ul class="task-jump" aria-label="Tasks on this page">
      <li><a href="#task-1"><span class="task-ico ico-t1"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="13" y="5.5" width="7" height="7" rx="1.6"/><path d="M15.2 5.5V2.5M17.8 5.5V2.5"/><path d="M16.5 12.5v1.8a3.7 3.7 0 0 1-3.7 3.7H9.2a3.7 3.7 0 0 0-3.7 3.7"/><path d="M4 8h5M4 11h3"/></svg></span>Task 1</a></li>
      <li><a href="#task-2"><span class="task-ico ico-t2"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="8" y="2.5" width="8" height="3" rx="1"/><path d="M9.5 5.5v4.5l1.3 1.5M14.5 5.5v4.5l-1.3 1.5"/><path d="M3.5 15.5c2.8-2.6 5.4 1 8.5-1.6s5.7 1 8.5-1.6v4.2c-2.8 2.6-5.4-1-8.5 1.6s-5.7-1-8.5 1.6z"/></svg></span>Task 2</a></li>
      <li><a href="#task-3"><span class="task-ico ico-t3"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 13h17a8.5 7.5 0 0 1-17 0z"/><path d="M8 21h8"/><path d="M19.5 2.5l-5.2 5.2"/><ellipse cx="12.6" cy="9.4" rx="2.4" ry="1.5" transform="rotate(-45 12.6 9.4)"/></svg></span>Task 3</a></li>
    </ul>
  </div>
</section>

<section id="results">
  <div class="container">
    <div class="results-shell">

      <div class="results-intro fade-in">
        <p>These are the final rankings of the EBiM Benchmark Competition 2026. The organizers evaluated each team's Phase II policy on the physical Franka Mobile FR3 Duo at two of the three testbeds (Hamburg, Munich, Shanghai). Each task is ranked independently.</p>
        <p>Congratulations to the prize-winning teams. Thank you to every team that took part, and to the testbed teams in Hamburg, Munich, and Shanghai.</p>
      </div>

      <div class="task task-note fade-in" id="task-1" role="region" aria-labelledby="task-1-title">
        <div class="task-head"><span class="task-ico ico-t1"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="13" y="5.5" width="7" height="7" rx="1.6"/><path d="M15.2 5.5V2.5M17.8 5.5V2.5"/><path d="M16.5 12.5v1.8a3.7 3.7 0 0 1-3.7 3.7H9.2a3.7 3.7 0 0 0-3.7 3.7"/><path d="M4 8h5M4 11h3"/></svg></span><h2 class="task-title" id="task-1-title"><span class="task-num">Task 1</span><span class="task-sep"> · </span><span class="task-name">Cable Routing &amp; Plugging</span></h2></div>
        <p>No prize is awarded for Task 1: the only Phase II submission could not be run on the real robot.</p>
      </div>

      <div class="task fade-in" id="task-2" role="region" aria-labelledby="task-2-title">
        <div class="task-head"><span class="task-ico ico-t2"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="8" y="2.5" width="8" height="3" rx="1"/><path d="M9.5 5.5v4.5l1.3 1.5M14.5 5.5v4.5l-1.3 1.5"/><path d="M3.5 15.5c2.8-2.6 5.4 1 8.5-1.6s5.7 1 8.5-1.6v4.2c-2.8 2.6-5.4-1-8.5 1.6s-5.7-1-8.5 1.6z"/></svg></span><h2 class="task-title" id="task-2-title"><span class="task-num">Task 2</span><span class="task-sep"> · </span><span class="task-name">Deformable Material Handling</span></h2></div>
        <div class="standings">
