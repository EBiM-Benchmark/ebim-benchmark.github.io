    #results thead th { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); font-weight: 700; white-space: nowrap; }
    #results tbody th { font-weight: 700; color: var(--text-dark); }
    #results tbody tr:last-child > * { border-bottom: 0; }
    #results .col-rank { font-variant-numeric: tabular-nums; font-weight: 800; color: var(--text-dark); }
    #results tr.is-prize .col-rank { color: var(--accent-dark); }
    #results .col-video a { font-weight: 600; border-bottom: 1px solid currentColor; }
    #results .col-video a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    @media (max-width: 700px) {
      #results .results-block { padding: 1.2rem 1rem; }
