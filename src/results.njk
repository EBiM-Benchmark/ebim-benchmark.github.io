{% block headStyle %}{% raw %}
  <style>
    .fade-in { opacity: 0; transform: translateY(20px); transition: opacity .55s ease, transform .55s ease; }
    .fade-in.visible { opacity: 1; transform: none; }

    /* Active nav link for the current page (Final Results, in the Competition dropdown) */
    .page-results .nav-dropdown a[href="results.html"] { color: var(--accent); font-weight: 700; }

    /* Back to top */
    #back-to-top {
      position: fixed; bottom: 2rem; right: 1.5rem; width: 44px; height: 44px; border-radius: 50%;
      background: var(--accent, #00d4ff); color: #0a0e1a; border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden; transform: translateY(12px);
      transition: opacity .3s, visibility .3s, transform .3s, background .2s, box-shadow .2s;
      z-index: 998; box-shadow: 0 4px 18px rgba(0,212,255,.35);
    }
    #back-to-top.visible { opacity: 1; visibility: visible; transform: none; }
    #back-to-top:hover { background: #fff; box-shadow: 0 6px 24px rgba(0,212,255,.45); }
    #back-to-top:focus-visible { outline: 2px solid #00d4ff; outline-offset: 3px; }
    #back-to-top svg { pointer-events: none; }

    /* ── Sub-page hero (copied from faq.njk — the global stylesheet has no .subhero/.breadcrumb) ── */
    #home.subhero {
      min-height: 32vh; display: flex; align-items: center; justify-content: center;
      position: relative; background: var(--bg-dark); overflow: hidden;
      padding: calc(var(--nav-h) + 2.5rem) 0 3rem; box-sizing: border-box;
    }
    #home.subhero::before {
      content: ''; position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,212,255,.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,212,255,.07) 1px, transparent 1px);
      background-size: 60px 60px; pointer-events: none;
    }
    #home.subhero::after {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(0,212,255,.10) 0%, transparent 70%);
      pointer-events: none;
    }
    .subhero-content { position: relative; z-index: 1; text-align: center; max-width: 820px; padding: 1.25rem 1.5rem; }
    .breadcrumb { display: inline-block; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.55); margin-bottom: 1rem; }
    .breadcrumb a { color: rgba(255,255,255,.55); transition: color .2s; }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb-sep { margin: 0 .55rem; opacity: .5; }
    .breadcrumb-current { color: var(--accent); }
    .subhero-title { font-size: clamp(1.7rem, 3.6vw, 2.6rem); color: #fff; font-weight: 800; line-height: 1.18; margin-bottom: .9rem; letter-spacing: -.01em; }
    .subhero-subtitle { font-size: clamp(.95rem, 1.6vw, 1.1rem); color: rgba(255,255,255,.72); margin-bottom: .8rem; max-width: 620px; margin-left: auto; margin-right: auto; }
    @media (max-width: 700px) { #home.subhero { min-height: 40vh; padding-top: calc(var(--nav-h) + 1.5rem); padding-bottom: 2rem; } }

    /* ── Final results ─────────────────────────────────────────────────────
       One bold element per task: a dark "podium" panel for places 1–3 that
       echoes the Real-World Excellence card on competition.html#awards (same
       navy gradient, cyan glow, gold/silver/bronze rules). The rest of the
       field sits in a quiet light strip attached underneath. Everything else
       (intro, Task 1 note, prizes, ranking method) stays plain prose. */
    #results {
      --medal-1: #eab308; --medal-2: #cbd5e1; --medal-3: #b45309;
      --medal-3-ink: #d4894a;  /* bronze lifted for text on navy: 6.4:1 */
      --label-ink: #0a7c95;    /* accent for small text on light: 4.7:1 */
      background: var(--bg-light);
    }
    #results .results-shell { max-width: 860px; margin: 0 auto; }
    #results .results-intro { max-width: 68ch; }
    #results .results-intro p { margin: 0 0 1rem; font-size: 1.05rem; line-height: 1.7; color: var(--text-mid); }
    #results .results-intro p:last-child { margin-bottom: 0; }

    /* Task headings: the task number is a quiet label, the task name carries the heading */
    #results .task { margin-top: 3.25rem; }
    #results .task-title { display: flex; flex-direction: column; gap: .3rem; margin: 0 0 1.1rem; text-align: left; }
    #results .task-num { font-size: .9rem; font-weight: 700; color: var(--label-ink); letter-spacing: .02em; }
    #results .task-sep { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    #results .task-name { font-size: clamp(1.4rem, 2.6vw, 1.85rem); font-weight: 800; line-height: 1.2; letter-spacing: -.015em; color: var(--text-dark); }

    /* Task 1: a slim note, deliberately low-key */
    #results .task-note { margin-top: 2.75rem; padding: 1.1rem 1.25rem; border: 1px dashed #cbd5e1; border-radius: var(--radius); background: transparent; }
    #results .task-note .task-title { margin-bottom: .45rem; }
    #results .task-note .task-name { font-size: 1.1rem; }
    #results .task-note p { margin: 0; font-size: .95rem; line-height: 1.6; color: var(--text-mid); }

    /* Standings card: dark podium on top, light field strip below */
    #results .standings { border-radius: 14px; overflow: hidden; box-shadow: 0 18px 50px rgba(10,14,26,.18); border: 1px solid rgba(0,212,255,.3); background: var(--bg-white); }
    #results .podium {
      position: relative; list-style: none; margin: 0; padding: 1.1rem;
      display: flex; flex-direction: column; gap: .6rem;
      background: linear-gradient(160deg, #0f1629 0%, #0a0e1a 100%);
    }
    #results .podium::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse 70% 60% at 90% -10%, rgba(0,212,255,.16), transparent 70%);
    }
    #results .podium-row {
      position: relative; display: grid; grid-template-columns: 3.25rem 1fr auto; align-items: center; column-gap: 1rem;
      padding: .95rem 1.1rem .95rem .9rem; border-radius: 10px; border-left: 4px solid transparent;
      background: rgba(255,255,255,.05);
    }
    #results .place-1 { border-left-color: var(--medal-1); background: rgba(234,179,8,.05); padding-top: 1.25rem; padding-bottom: 1.25rem; }
    #results .place-2 { border-left-color: var(--medal-2); }
    #results .place-3 { border-left-color: var(--medal-3); }
    #results .podium-rank { font-size: 2.4rem; font-weight: 800; line-height: 1; text-align: center; font-variant-numeric: tabular-nums; }
    #results .place-1 .podium-rank { font-size: 3rem; color: var(--medal-1); }
    #results .place-2 .podium-rank { color: var(--medal-2); }
    #results .place-3 .podium-rank { color: var(--medal-3-ink); }
    #results .podium-team { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
    #results .podium .team-name { font-size: 1.3rem; font-weight: 800; color: #fff; line-height: 1.2; letter-spacing: -.01em; overflow-wrap: anywhere; }
    #results .place-1 .team-name { font-size: 1.6rem; }
    #results .team-place { font-size: .85rem; color: rgba(255,255,255,.62); }
    #results .podium-video {
      display: inline-flex; align-items: center; gap: .45rem; white-space: nowrap;
      padding: .5rem .95rem; border-radius: 999px; border: 1px solid rgba(0,212,255,.55);
      color: var(--accent); font-size: .9rem; font-weight: 600; text-decoration: none;
      transition: background .2s, color .2s, border-color .2s;
    }
    #results .podium-video svg { flex: none; }
    #results .podium-video:hover { background: var(--accent); color: #0a0e1a; border-color: var(--accent); }
    #results .podium-video:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

    #results .field { list-style: none; margin: 0; padding: .35rem 1.1rem .5rem; }
    #results .field li { display: grid; grid-template-columns: 3.25rem 1fr; column-gap: 1rem; align-items: baseline; padding: .7rem 0 .7rem .9rem; border-top: 1px solid var(--border); }
    #results .field li:first-child { border-top: 0; }
    #results .field-rank { text-align: center; font-weight: 700; color: #64748b; font-variant-numeric: tabular-nums; }
    #results .field .team-name { font-weight: 600; color: var(--text-dark); overflow-wrap: anywhere; }

    /* Prizes and ranking method: plain prose under a hairline */
    #results .results-prose { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--border); }
    #results .results-prose + .results-prose { margin-top: 2.25rem; }
    #results .results-prose h2 { font-size: 1.25rem; font-weight: 800; color: var(--text-dark); margin: 0 0 .75rem; text-align: left; }
    #results .results-prose p { margin: 0 0 1rem; max-width: 72ch; font-size: .98rem; line-height: 1.7; color: var(--text-mid); }
    #results .results-prose p:last-child { margin-bottom: 0; }
    #results .results-prose p a { color: var(--label-ink); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
    #results .criteria { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; }
    #results .criteria li { padding: .95rem 1.1rem; border-radius: var(--radius); background: var(--bg-white); border: 1px solid var(--border); border-left: 3px solid var(--accent); font-size: .95rem; line-height: 1.6; color: var(--text-mid); }

    @media (max-width: 640px) {
      #results .task { margin-top: 2.5rem; }
      #results .podium { padding: .75rem; }
      #results .podium-row { grid-template-columns: 2.4rem 1fr; row-gap: .7rem; column-gap: .75rem; padding: .85rem .85rem .85rem .7rem; }
      #results .podium-rank { font-size: 1.9rem; }
      #results .place-1 .podium-rank { font-size: 2.3rem; }
      #results .podium .team-name { font-size: 1.15rem; }
      #results .place-1 .team-name { font-size: 1.35rem; }
      #results .podium-video { grid-column: 2; justify-self: start; }
      #results .field { padding: .25rem .75rem .4rem; }
      #results .field li { grid-template-columns: 2.4rem 1fr; column-gap: .75rem; padding-left: .7rem; }
      #results .criteria { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .fade-in { opacity: 1; transform: none; transition: none; }
      #results .podium-video { transition: none; }
    }
  </style>
{% endraw %}{% endblock %}

{% block main %}{% raw %}
<main id="main-content">
<section id="home" class="subhero">
  <div class="subhero-content">
    <div class="hero-wordmark hero-wordmark-sm" role="img" aria-label="EBiM Benchmark">
      <span class="hero-wordmark-mark">EBiM</span><span class="hero-wordmark-sub">Benchmark</span>
    </div>
    <div class="breadcrumb" aria-label="Breadcrumb">
      <a href="index.html">Home</a>
      <span class="breadcrumb-sep">/</span>
      <a href="competition.html">Competition</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">Final Results</span>
    </div>
    <h1 class="subhero-title">Final Results</h1>
    <p class="subhero-subtitle">EBiM Benchmark Competition 2026</p>
  </div>
</section>

<section id="results">
  <div class="container">
    <div class="results-shell">

      <div class="results-intro fade-in">
        <p>These are the final rankings of the EBiM Benchmark Competition 2026. The organizers evaluated each team's Phase II policy on the physical Franka Mobile FR3 Duo at two of the three testbeds (Hamburg, Munich, Shanghai). Each task is ranked independently.</p>
        <p>Congratulations to the prize-winning teams. Thank you to every team that took part, and to the testbed teams in Hamburg, Munich, and Shanghai.</p>
      </div>

      <div class="task task-note fade-in" id="task-1" role="region" aria-labelledby="task-1-title">
        <h2 class="task-title" id="task-1-title"><span class="task-num">Task 1</span><span class="task-sep"> · </span><span class="task-name">Cable Routing &amp; Plugging</span></h2>
        <p>No prize is awarded for Task 1: the only Phase II submission could not be run on the real robot.</p>
      </div>

      <div class="task fade-in" id="task-2" role="region" aria-labelledby="task-2-title">
        <h2 class="task-title" id="task-2-title"><span class="task-num">Task 2</span><span class="task-sep"> · </span><span class="task-name">Deformable Material Handling</span></h2>
        <div class="standings">
          <ol class="podium" role="list" aria-label="Prize places">
            <li class="podium-row place-1">
              <span class="podium-rank" aria-hidden="true">1</span>
              <div class="podium-team"><span class="team-name">Hajimi</span><span class="team-place">1st place</span></div>
              <a class="podium-video" href="https://cloud.uni-hamburg.de/s/KbgEojL2QQTgA4R?dir=/Hajimi" target="_blank" rel="noopener" aria-label="Watch Hajimi&#x27;s Task 2 evaluation videos"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>Watch</a>
            </li>
            <li class="podium-row place-2">
              <span class="podium-rank" aria-hidden="true">2</span>
              <div class="podium-team"><span class="team-name">HKUST-RockAI</span><span class="team-place">2nd place</span></div>
              <a class="podium-video" href="https://cloud.uni-hamburg.de/s/KbgEojL2QQTgA4R?dir=/HKUST-RockAI" target="_blank" rel="noopener" aria-label="Watch HKUST-RockAI&#x27;s Task 2 evaluation videos"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>Watch</a>
            </li>
            <li class="podium-row place-3">
              <span class="podium-rank" aria-hidden="true">3</span>
              <div class="podium-team"><span class="team-name">Camelo</span><span class="team-place">3rd place</span></div>
              <a class="podium-video" href="https://cloud.uni-hamburg.de/s/KbgEojL2QQTgA4R?dir=/Camelo" target="_blank" rel="noopener" aria-label="Watch Camelo&#x27;s Task 2 evaluation videos"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>Watch</a>
            </li>
          </ol>
          <ol class="field" role="list" aria-label="Other ranked teams">
            <li><span class="field-rank">4</span><span class="team-name">StarCore SJTU</span></li>
            <li><span class="field-rank">5</span><span class="team-name">EDL Team</span></li>
            <li><span class="field-rank">5</span><span class="team-name">ROBOT DREAMS</span></li>
            <li><span class="field-rank">7</span><span class="team-name">Sinica CITI Boy</span></li>
          </ol>
        </div>
      </div>

      <div class="task fade-in" id="task-3" role="region" aria-labelledby="task-3-title">
        <h2 class="task-title" id="task-3-title"><span class="task-num">Task 3</span><span class="task-sep"> · </span><span class="task-name">Assisted Living &amp; Feeding</span></h2>
        <div class="standings">
          <ol class="podium" role="list" aria-label="Prize places">
            <li class="podium-row place-1">
              <span class="podium-rank" aria-hidden="true">1</span>
              <div class="podium-team"><span class="team-name">rl_alpha</span><span class="team-place">1st place</span></div>
              <a class="podium-video" href="https://cloud.uni-hamburg.de/s/KbgEojL2QQTgA4R?dir=/rl_alpha" target="_blank" rel="noopener" aria-label="Watch rl_alpha&#x27;s Task 3 evaluation videos"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>Watch</a>
            </li>
            <li class="podium-row place-2">
              <span class="podium-rank" aria-hidden="true">2</span>
              <div class="podium-team"><span class="team-name">Bierbyte</span><span class="team-place">2nd place</span></div>
              <a class="podium-video" href="https://cloud.uni-hamburg.de/s/KbgEojL2QQTgA4R?dir=/Bierbyte" target="_blank" rel="noopener" aria-label="Watch Bierbyte&#x27;s Task 3 evaluation videos"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>Watch</a>
            </li>
            <li class="podium-row place-3">
              <span class="podium-rank" aria-hidden="true">3</span>
              <div class="podium-team"><span class="team-name">EDL Team</span><span class="team-place">3rd place</span></div>
              <a class="podium-video" href="https://cloud.uni-hamburg.de/s/KbgEojL2QQTgA4R?dir=/EDL%20Team_task3" target="_blank" rel="noopener" aria-label="Watch EDL Team&#x27;s Task 3 evaluation videos"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>Watch</a>
            </li>
          </ol>
          <ol class="field" role="list" aria-label="Other ranked teams">
            <li><span class="field-rank">4</span><span class="team-name">world model</span></li>
            <li><span class="field-rank">5</span><span class="team-name">AirSign</span></li>
          </ol>
        </div>
      </div>

      <div class="results-prose fade-in" id="prizes">
        <h2>Prizes</h2>
        <p>Places 1–3 in each task receive the Real-World Excellence prizes listed under <a href="competition.html#awards">Awards &amp; Prizes</a>. The cash component is awarded only to prize places with a score above zero. Prize places that scored zero receive the Franka Robotics purchase voucher, the trophy (1st place) and the special design gift, without cash. The organizers will email the winning teams about prize delivery. The Simulation Prize is not awarded in 2026. The InnoHub Special Award results will be announced separately.</p>
      </div>

      <div class="results-prose fade-in" id="ranking-method">
        <h2>How teams were ranked</h2>
        <p>Few submissions scored above zero on real hardware. Teams with a score above zero are ranked by score. To rank the remaining teams, the organizing committee assessed how far each policy progressed during the official evaluations:</p>
        <ul class="criteria">
          <li>Task 2: grasp engagement first (whether the arm reached for the target and the gripper closed), then navigation.</li>
          <li>Task 3: navigation first (how far the robot navigated toward the table), then arm engagement.</li>
        </ul>
        <p>Teams that could not be separated share a rank, and the next rank is skipped. The committee adopted this criterion after evaluation because the published criteria did not separate teams that scored zero. It applies only to those teams.</p>
      </div>

    </div>
  </div>
</section>
</main>
{% endraw %}{% endblock %}
