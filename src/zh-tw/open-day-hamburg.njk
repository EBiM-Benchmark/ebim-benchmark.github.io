<!-- ============================================================
     REGISTER — state-gated on site.openDayRegistration
     ("open" → live RSVP form | "waitlist" → form + banner + list=waitlist
      | "closed" → no form, closed panel). See _data/site.json.
     ============================================================ -->
<section id="register">
  <div class="container">
    <div class="text-center fade-in">
      <h2 class="section-title">報名</h2>
    </div>

{%- if site.openDayRegistration == "closed" %}

    <div class="od-closed fade-in">
      <div class="od-closed-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <h3>漢堡開放日的報名已截止。</h3>
      <p>如對本次活動有任何疑問，請<a href="{{ links.contact }}">與我們聯絡</a>。</p>
    </div>

{%- else %}

    <div class="od-notice fade-in">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
      <span>免費參加。部分名額保留給 IJCAI-ECAI 2026 參會者。報名將持續開放至 8 月 17 日（週一）活動開始前。場地共有 80 個名額，數量有限。請在出發前完成報名——現場恕不接受未報名者入場。名額以電子郵件確認為準；送出表單並不代表已取得名額。</span>
    </div>

    <div class="reg-card fade-in">

{%- if site.openDayRegistration == "waitlist" %}
      <div class="od-waitlist">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span>80 個名額已全數額滿。您仍可登記候補——如有空位，我們會以電子郵件通知您。</span>
      </div>
{%- endif %}

      <!-- Native Web3Forms RSVP form. AJAX-first (see open-day-form-script.njk);
           hCaptcha is enabled on this key and enforced server-side, so JS is required to submit. -->
      <form id="openDayForm" action="https://api.web3forms.com/submit" method="POST"
            data-msg-referral="請至少選擇一種得知開放日的管道（或填寫「其他」）。"
            data-msg-captcha="請先完成人機驗證再送出。"
            data-msg-generic="發生錯誤，請再試一次。"
            data-msg-network="網路錯誤，請稍後再試。"
            data-sending="送出中⋯⋯"
            data-submit-label="送出報名">

        <div class="reg-form">

          <div class="form-field">
            <label class="form-label" for="full_name">姓名（須與您的附照片證件一致） <span class="req" aria-hidden="true">*</span>
              <span class="form-label-note">櫃檯將據此核對您的證件</span></label>
            <input class="form-input" type="text" id="full_name" name="full_name" maxlength="120" required placeholder="您的全名" />
          </div>

          <div class="form-field">
            <label class="form-label" for="email">Email <span class="req" aria-hidden="true">*</span>
              <span class="form-label-note">確認信將寄送至此信箱</span></label>
            <input class="form-input" type="email" id="email" name="email" maxlength="200" required placeholder="you@example.org" />
          </div>

          <div class="form-field">
            <label class="form-label" for="affiliation">所屬單位（學校或機構） <span class="req" aria-hidden="true">*</span></label>
            <input class="form-input" type="text" id="affiliation" name="affiliation" maxlength="200" required placeholder="例如：漢堡大學" />
          </div>

          <div class="form-field">
            <label class="form-label" for="country">國家或地區 <span class="req" aria-hidden="true">*</span></label>
            <input class="form-input" type="text" id="country" name="country" maxlength="120" required placeholder="例如：德國" />
          </div>

          <fieldset class="form-field">
            <legend class="form-label">您是否參加在不來梅舉行的 IJCAI-ECAI 2026？ <span class="req" aria-hidden="true">*</span></legend>
            <div class="od-radios">
              <label class="reg-check"><input type="radio" name="ijcai_attendee" value="Yes" required /> <span>是</span></label>
              <label class="reg-check"><input type="radio" name="ijcai_attendee" value="No" /> <span>否</span></label>
            </div>
          </fieldset>

          <fieldset class="form-field">
            <legend class="form-label">您是否參加下午的實地參觀與實驗室參訪？ <span class="req" aria-hidden="true">*</span>
              <span class="form-label-note">EBiM 評測中心 + 漢堡大學實驗室，14:00–17:00</span></legend>
            <div class="od-radios">
              <label class="reg-check"><input type="radio" name="afternoon_visits" value="Yes" required /> <span>是</span></label>
              <label class="reg-check"><input type="radio" name="afternoon_visits" value="No" /> <span>否</span></label>
            </div>
          </fieldset>

          <div class="form-field">
            <label class="form-label" for="dietary">飲食需求 <span class="form-label-note">（選填——午餐由 Google 提供）</span></label>
            <input class="form-input" type="text" id="dietary" name="dietary" maxlength="200" placeholder="例如：素食、堅果過敏" />
          </div>

          <fieldset class="form-field">
            <legend class="form-label">您從哪裡得知本次開放日？ <span class="req" aria-hidden="true">*</span></legend>
            <div class="reg-checks">
              <label class="reg-check"><input type="checkbox" name="referral" value="Discord" /> <span>Discord</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="WeChat" /> <span>微信</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="Colleague or word of mouth" /> <span>同事或口耳相傳</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="IJCAI-ECAI 2026" /> <span>IJCAI-ECAI 2026</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="X (Twitter)" /> <span>X（推特）</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="LinkedIn" /> <span>LinkedIn</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="Mailing list" /> <span>郵寄名單</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="Search engine" /> <span>搜尋引擎</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="The EBiM website" /> <span>EBiM 官方網站</span></label>
            </div>
            <input class="form-input reg-check-other" type="text" name="referral_other" maxlength="200" placeholder="其他（請註明）" />
          </fieldset>

          <!-- ── Consent ── -->
          <div class="form-field">
            <div class="reg-checks">
              <label class="reg-check">
                <input type="checkbox" name="consent_guestlist" value="Yes" required />
                <span>我同意將我的姓名與所屬單位提供給 Google Germany GmbH，以辦理大樓門禁登記。（必填——場地無法接待未列入名單的來賓。） <span class="req" aria-hidden="true">*</span></span>
              </label>
              <label class="reg-check">
                <input type="checkbox" name="consent_media_notice" value="Yes" required />
                <span>我了解本次活動將進行拍照與錄影，相關影像可能由 EBiM 主辦單位及合作夥伴公開發布。 <span class="req" aria-hidden="true">*</span></span>
              </label>
              <label class="reg-check">
                <input type="checkbox" name="media_optout" value="Yes" />
                <span>請勿將我收錄於公開發布的照片或影片中。</span>
              </label>
            </div>
          </div>

          <!-- Hidden Web3Forms fields -->
          <input type="hidden" name="access_key" value="d6f9fc0c-13e6-473f-b8a1-adc21f267e6b" />
          <input type="hidden" name="from_name" value="EBiM Benchmark — Open Day Hamburg" />
          <input type="hidden" name="subject" value="[OPEN DAY HAMBURG] New registration" />
          <input type="hidden" name="redirect" value="https://ebim-benchmark.github.io/zh-tw/open-day-success.html" />
{%- if site.openDayRegistration == "waitlist" %}
          <input type="hidden" name="list" value="waitlist" />
{%- endif %}

          <!-- Honeypot -->
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <!-- hCaptcha (zero-config via web3forms client script, loaded in trailingScripts) -->
          <div class="h-captcha" data-captcha="true"></div>

          <div id="formError" class="form-error" role="alert" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span id="formErrorText">發生錯誤，請再試一次。</span>
          </div>

          <button type="submit" class="btn btn-submit">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11Z"/>
            </svg>
            <span class="btn-label">送出報名</span>
          </button>

          <noscript><p class="reg-noscript">必須啟用 JavaScript 才能完成報名（垃圾訊息檢查需要用到）。若無法啟用，請寄送電子郵件至 <a href="mailto:organizers@ebim-benchmark.org">organizers@ebim-benchmark.org</a>。</p></noscript>

        </div>
      </form>

      <div id="formSuccess" class="form-success" role="status" hidden>
        <div class="form-success-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <h2>感謝您！</h2>
        <p>我們已收到您的報名。確認信將隨後寄出；名額須經我們確認後才會保留，因此請勿僅憑本頁面安排行程。</p>
        <a href="index.html" class="btn btn-submit" style="max-width:240px;margin:0 auto;">返回首頁</a>
      </div>

    </div>

    <p class="reg-privacy fade-in">我們僅會將您的資料用於籌辦 EBiM 開放日——包括為辦理大樓門禁登記，而將您的姓名與所屬單位提供給 Google Germany GmbH。我們不會出售您的資料，也不會將您加入任何郵寄名單。報名資料由 Web3Forms 處理。</p>

{%- endif %}

  </div>
</section>

