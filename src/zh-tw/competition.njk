{% extends "layouts/base.njk" %}

{% block headStructured %}
  <!-- Open Graph -->
  <meta property="og:type"            content="website" />
  <meta property="og:site_name"       content="EBiM Benchmark" />
  <meta property="og:url"             content="https://ebim-benchmark.github.io/zh-tw/competition.html" />
  <meta property="og:title"           content="{{ pageMeta.ogTitle | safe }}" />
  <meta property="og:description"     content="{{ pageMeta.ogDescription | safe }}" />
  <meta property="og:image"           content="https://ebim-benchmark.github.io/img/og-cover.png" />
  <meta property="og:image:width"     content="1200" />
  <meta property="og:image:height"    content="630" />
  <meta property="og:image:alt"       content="EBiM Benchmark — 邁向真實世界具身雙臂操作的全球協同基準" />
  <meta property="og:locale"          content="zh_TW" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card"           content="summary_large_image" />
  <meta name="twitter:title"          content="{{ pageMeta.twitterTitle | safe }}" />
  <meta name="twitter:description"    content="{{ pageMeta.twitterDescription | safe }}" />
  <meta name="twitter:image"          content="https://ebim-benchmark.github.io/img/og-cover.png" />
  <meta name="twitter:image:alt"      content="EBiM Benchmark — 邁向真實世界具身雙臂操作的全球協同基準" />
{% include "jsonld.njk" %}
{% endblock %}

{% block headStyle %}{% raw %}
  <!-- Critical CSS inlined to prevent FOUC -->
  <style>
    /* Fade-in default state — must be set before JS runs */
    .fade-in { opacity: 0; transform: translateY(20px); transition: opacity .55s ease, transform .55s ease; }
    .fade-in.visible { opacity: 1; transform: none; }
    /* Stagger children inside a fade-in parent */
    .fade-in > *:nth-child(2) { transition-delay: .08s; }
    .fade-in > *:nth-child(3) { transition-delay: .16s; }
    .fade-in > *:nth-child(4) { transition-delay: .24s; }
    .fade-in > *:nth-child(5) { transition-delay: .32s; }
    .fade-in > *:nth-child(6) { transition-delay: .40s; }
    /* Active nav link */
    .nav-links a.active { color: var(--accent) !important; }
    /* InnoHub Special Award block: the only .prize-hardware card with a paragraph
       after the pill list, and the only one with an in-prose link. */
    .prize-hardware-list + .prize-hardware-desc { margin-top: .85rem; }
    .prize-hardware-desc a { text-decoration: underline; }
    /* Back to top */
    #back-to-top {
      position: fixed; bottom: 2rem; right: 1.5rem;
      width: 44px; height: 44px; border-radius: 50%;
      background: var(--accent, #00d4ff); color: #0a0e1a;
      border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden; transform: translateY(12px);
      transition: opacity .3s, visibility .3s, transform .3s, background .2s, box-shadow .2s;
      z-index: 998;
      box-shadow: 0 4px 18px rgba(0,212,255,.35);
    }
    #back-to-top.visible { opacity: 1; visibility: visible; transform: none; }
    #back-to-top:hover { background: #fff; box-shadow: 0 6px 24px rgba(0,212,255,.45); }
    #back-to-top:focus-visible { outline: 2px solid #00d4ff; outline-offset: 3px; }
    #back-to-top svg { pointer-events: none; }

    /* ── Sub-page hero (shorter than home #home) ──
       Selector specificity bumped to (1,1,0) via `#home.subhero` to override
       `#home { min-height: 100vh; padding: ... }` from the global stylesheet.
       Pseudo-element rules likewise override #home::before/::after. */
    #home.subhero {
      min-height: 40vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      background: var(--bg-dark);
      overflow: hidden;
      padding: calc(var(--nav-h) + 2.5rem) 0 3rem;
      box-sizing: border-box;
    }
    #home.subhero::before {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,212,255,.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,212,255,.07) 1px, transparent 1px);
      background-size: 60px 60px;
      animation: none;
      pointer-events: none;
    }
    #home.subhero::after {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(0,212,255,.10) 0%, transparent 70%);
      pointer-events: none;
    }
    .subhero-content {
      position: relative; z-index: 1;
      text-align: center;
      max-width: 820px;
      padding: 1.25rem 1.5rem;
    }
    .breadcrumb {
      display: inline-block;
      font-size: .78rem;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: rgba(255,255,255,.55);
      margin-bottom: 1rem;
    }
    .breadcrumb a {
      color: rgba(255,255,255,.55);
      transition: color .2s;
    }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb-sep { margin: 0 .55rem; opacity: .5; }
    .breadcrumb-current { color: var(--accent); }
    .subhero-title {
      font-size: clamp(1.7rem, 3.6vw, 2.6rem);
      color: #fff;
      font-weight: 800;
      line-height: 1.18;
      margin-bottom: .9rem;
      letter-spacing: -.01em;
    }
    .subhero-subtitle {
      font-size: clamp(.95rem, 1.6vw, 1.1rem);
      color: rgba(255,255,255,.72);
      margin-bottom: 1.6rem;
      max-width: 640px;
      margin-left: auto; margin-right: auto;
    }
    .subhero-badge {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      background: rgba(234,179,8,.18);
      border: 1px solid rgba(234,179,8,.45);
      color: #fde68a;
      font-size: .85rem;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      padding: .4rem 1rem;
      border-radius: 100px;
      margin-bottom: 1.2rem;
    }
    .subhero-badge strong { font-weight: 700; }
    .subhero-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    @media (max-width: 700px) {
      #home.subhero { min-height: 50vh; padding-top: calc(var(--nav-h) + 1.5rem); padding-bottom: 2rem; }
    }

    /* ── Three-Phase context note (Phase III link to workshop page) ── */
    .pipeline-note {
      max-width: 760px;
      margin: 1.75rem auto 0;
      text-align: center;
      font-size: .95rem;
      color: var(--text-muted);
      line-height: 1.6;
    }
    .pipeline-note a { color: var(--accent); font-weight: 600; }
    .pipeline-note a:hover { text-decoration: underline; }

    /* ── Testbed Locations grid ── */
    .testbed-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      margin-top: 2.5rem;
    }
    @media (max-width: 980px) {
      .testbed-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 520px) {
      .testbed-grid { grid-template-columns: 1fr; }
    }
    .testbed-card {
      background: #fff;
      border: 1px solid rgba(10,14,26,.08);
      border-radius: 14px;
      padding: 1.4rem 1.25rem;
      text-align: center;
      transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }
    .testbed-card:hover {
      transform: translateY(-4px);
      border-color: rgba(0,212,255,.45);
      box-shadow: 0 10px 30px rgba(10,14,26,.08);
    }
    .testbed-flag {
      display: block;
      width: 40px;
      height: 30px;
      margin: 0 auto .55rem;
      border-radius: 3px;
      border: 1px solid rgba(10,14,26,.08);
      object-fit: cover;
    }
    .testbed-city {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--bg-dark);
      margin-bottom: .35rem;
      letter-spacing: -.005em;
    }
    .testbed-institution {
      font-size: .9rem;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: .5rem;
    }
    .testbed-role {
      font-size: .85rem;
      color: var(--text-muted);
      line-height: 1.5;
    }
    .testbed-lead {
      margin-top: .5rem;
      font-size: .78rem;
      color: var(--text-mid);
    }
    .testbed-lead-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .6rem;
      margin-top: .5rem;
      text-align: left;
    }
    .testbed-lead-row .testbed-lead { margin-top: 0; }
    .testbed-future {
      max-width: 380px;
      margin: 2rem auto 0;
    }
    .testbed-status {
      margin-bottom: .5rem;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--text-mid);
    }
    .testbed-link {
      display: inline-block;
      margin-top: .6rem;
      font-size: .82rem;
      font-weight: 700;
      color: var(--accent-dark);
    }
    .testbed-link:hover { color: var(--accent); }

    /* ── Why This Benchmark ── */
    .why-benchmark p {
      max-width: 880px;
      margin: 1.25rem auto 0;
      font-size: 1.05rem;
      line-height: 1.75;
      color: var(--text-body, #2c3243);
      text-align: left;
    }

    /* ── Workshop callout banner ──
       Selector specificity bumped to (0,1,1) so it beats `section:nth-child(even)`
       from the global stylesheet if section order ever shifts. */
    section.workshop-callout {
      background: linear-gradient(135deg, #0a2a4a 0%, #00b4d8 100%);
      color: #fff;
      padding: 3rem 1.5rem;
    }
    .workshop-callout-inner {
      max-width: 880px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .workshop-callout h3 {
      color: #fff;
      font-size: clamp(1.25rem, 2.4vw, 1.6rem);
      font-weight: 800;
      margin-bottom: .4rem;
    }
    .workshop-callout p {
      color: rgba(255,255,255,.85);
      font-size: .98rem;
      max-width: 520px;
      margin: 0;
    }
    .workshop-callout .btn {
      background: #fff;
      color: #0a2a4a;
      white-space: nowrap;
    }
    .workshop-callout .btn:hover {
      background: #0a0e1a;
      color: #fff;
      transform: translateY(-2px);
    }
    @media (max-width: 640px) {
      .workshop-callout-inner { flex-direction: column; text-align: center; }
    }
    .community-resource-card {
      display: flex;
      gap: 1.1rem;
      align-items: flex-start;
      background: var(--bg-light);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem 1.5rem;
      max-width: 640px;
      text-decoration: none;
      transition: border-color var(--transition), box-shadow var(--transition);
    }
    .community-resource-card:hover {
      border-color: var(--accent);
      box-shadow: 0 4px 20px rgba(0,212,255,.08);
    }

    /* ── Submission section ── */
    #submission { background: var(--bg-white); }
    #submission .submit-wrap { max-width: 720px; margin: 0 auto; }
    #submission .submit-cta { text-align: center; margin-bottom: 2rem; }
    #submission .submit-cta .btn { text-decoration: none; }
    #submission .submit-note { font-size: .82rem; color: var(--text-mid); margin: .75rem auto 0; max-width: 520px; }
    #submission .submit-card { background: var(--bg-white); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--card-shadow); padding: 1.5rem 1.6rem; margin-bottom: 1.3rem; }
    #submission .submit-card-h { font-size: .7rem; letter-spacing: .13em; text-transform: uppercase; color: var(--text-mid); font-weight: 700; margin: 0 0 1.1rem; }
    #submission .submit-req { display: flex; gap: 1rem; align-items: flex-start; }
    #submission .submit-req + .submit-req { margin-top: 1rem; }
    #submission .submit-req-ico { flex-shrink: 0; width: 36px; height: 36px; border-radius: 8px; background: rgba(0,212,255,.1); color: var(--accent-dark); display: flex; align-items: center; justify-content: center; }
    #submission .submit-req-ico svg { width: 19px; height: 19px; }
    #submission .submit-req-t { margin: 0; font-weight: 700; color: var(--text-dark); font-size: .92rem; }
    #submission .submit-req-d { margin: .15rem 0 0; color: var(--text-mid); font-size: .85rem; }
    #submission .submit-card-foot { border-top: 1px solid var(--border); margin-top: 1.2rem; padding-top: 1rem; }
    #submission .submit-card-foot p { margin: 0; color: var(--text-mid); font-size: .85rem; line-height: 1.62; }
    #submission .submit-verify { border-left: 3px solid var(--accent); background: var(--bg-light); border-radius: 0 8px 8px 0; padding: .95rem 1.25rem; }
    #submission .submit-verify p { margin: 0; color: var(--text-mid); font-size: .83rem; line-height: 1.65; }
    #submission .submit-card-foot strong, #submission .submit-verify strong { color: var(--text-dark); }
    @media (max-width: 560px) { #submission .submit-card, #submission .submit-verify { padding-left: 1.1rem; padding-right: 1.1rem; } }

    /* ── Get the Code section ── */
    #get-benchmark { background: var(--bg-light); }
    #get-benchmark .getbench-wrap { max-width: 680px; margin: 0 auto; }
    #get-benchmark .getbench-lead { color: var(--text-mid); font-size: 1rem; line-height: 1.6; margin: 0 auto 1.5rem; text-align: center; }
    #get-benchmark .getbench-cta { text-align: center; margin-bottom: 1.5rem; }
    #get-benchmark .getbench-cta .btn { text-decoration: none; }
    #get-benchmark .getbench-note { border-left: 3px solid var(--accent); background: var(--bg-white); border-radius: 0 8px 8px 0; padding: .95rem 1.25rem; margin: 0 0 1.3rem; }
    #get-benchmark .getbench-note p { margin: 0; color: var(--text-mid); font-size: .84rem; line-height: 1.6; }
    #get-benchmark .getbench-note strong { color: var(--text-dark); }
    #get-benchmark .getbench-note a { color: #0e7490; font-weight: 700; text-decoration: underline; }
    #get-benchmark .getbench-coming { color: var(--text-mid); font-size: .82rem; line-height: 1.6; margin: 0; }
    /* Platinum: always 2/2/1. An empty flex item takes a whole line between
       card 4 and card 5 (via order; DOM, reading and focus order unchanged),
       so card 5 wraps whatever the logo and caption widths — the zh AMD card
       is narrow enough for card 5 to fit on row 2 otherwise. The breaker's
       zero-height line still adds a second row-gap, which card 5's negative
       top margin takes back. At <=600px every card is full-width, so both
       are dropped there. */
    .partners-tier.tier-platinum .partners-logos::after {
      content: "";
      flex: 0 0 100%;
      height: 0;
      order: 1;
    }
    .partners-tier.tier-platinum .partner-card:nth-child(n+5) { order: 2; margin-top: -1.25rem; }
    @media (max-width: 600px) {
      .partners-tier.tier-platinum .partners-logos::after { display: none; }
      .partners-tier.tier-platinum .partner-card:nth-child(n+5) { margin-top: 0; }
    }
    /* Final-results banner at the top of #awards, linking to the results page */
    .results-banner {
      max-width: 720px; margin: 0 auto 2rem; padding: .85rem 1.25rem;
      text-align: center; font-size: .98rem; color: var(--text-dark);
      background: var(--bg-white); border: 1px solid var(--accent); border-left-width: 4px;
      border-radius: var(--radius);
    }
    .results-banner a { color: var(--accent-dark); font-weight: 700; text-decoration: underline; }
    .results-banner a:hover { color: var(--accent); }

    /* "Final Result Announcement" date label, linked to the results page */
    .date-label a { color: inherit; border-bottom: 1px dashed currentColor; }
    .date-label a:hover { color: var(--accent); }
  </style>
{% endraw %}{% endblock %}

{% block main %}{% raw %}
<main id="main-content">

<!-- ============================================================
     SUB-PAGE HERO
     ============================================================ -->
<section id="home" class="subhero">
  <div class="subhero-content">
    <div class="hero-wordmark hero-wordmark-sm" role="img" aria-label="EBiM Benchmark">
      <span class="hero-wordmark-mark">EBiM</span>
      <span class="hero-wordmark-sub">Benchmark</span>
    </div>

    <div class="breadcrumb" aria-label="麵包屑導覽">
      <a href="index.html">首頁</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">競賽</span>
    </div>

    <div class="subhero-badge" aria-label="獎金池">
      <span aria-hidden="true">🏆</span>
      <strong>每項任務最高 $5,250 · 現金 + 採購抵用券、獎盃與禮品</strong>
    </div>

    <h1 class="subhero-title">EBiM 競賽</h1>
    <p class="subhero-subtitle">
      針對真實世界具身雙臂操作的全球協同基準
    </p>

    <div class="subhero-actions">
      <a href="register.html" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11Z"/>
        </svg>
        報名
      </a>
      <a href="#get-benchmark" class="btn btn-outline">取得程式碼</a>
    </div>
  </div>
</section>


<!-- ============================================================
     ON-PAGE TOC SIDEBAR (desktop ≥ 1400px only — hidden via CSS otherwise)
     ============================================================ -->
<aside class="toc-sidebar" aria-labelledby="toc-label">
  <div id="toc-label" class="toc-sidebar-label">本頁內容</div>
  <ul>
    <li><a href="#why">為何需要本基準</a></li>
    <li><a href="#overview">三階段機制</a></li>
    <li><a href="#platform">Mobile FR3 Duo</a></li>
    <li><a href="#benchmark">基準測試</a></li>
    <li><a href="#tasks">基準任務</a></li>
    <li><a href="#testbeds">跨洲測試平台</a></li>
    <li><a href="#architecture">競賽架構</a></li>
    <li><a href="#call-for-participation">參賽招募</a></li>
    <li><a href="#get-benchmark">取得程式碼</a></li>
    <li><a href="#submission">作品繳交</a></li>
    <li><a href="#awards">獎項與獎金</a></li>
    <li><a href="#partners">合作夥伴</a></li>
  </ul>
</aside>


<!-- ============================================================
     WHY THIS BENCHMARK
     ============================================================ -->
<section id="why" class="why-benchmark">
  <div class="container">
    <div class="text-center fade-in">
      <h2 class="section-title">為何需要本基準</h2>
    </div>
    <p class="fade-in">
      現今的雙臂操作基準相當零散。有些只在模擬中評估演算法；另一些則只在單一實驗室的單台機器人上測試。兩者都無法回答最關鍵的問題：這些方法能否在不同的平台、環境與操作者之間泛化？EBiM 競賽推出一項全球協同的基準，結合開放的模擬階段，以及在相同 Mobile FR3 Duo 平台上進行的跨洲實機驗證。透過在漢堡、慕尼黑與上海的實體硬體上驗證表現最佳的模擬方法，我們為具身雙臂操作建立首個可重現、跨實驗室的基準。
    </p>
  </div>
</section>


<!-- ============================================================
     THREE-PHASE MECHANISM (Phases I & II lead into the workshop)
     ============================================================ -->
<section id="overview">
  <div class="container">

    <div class="text-center fade-in">
      <h2 class="section-title">三階段機制</h2>
      <p class="section-subtitle">
        第一與第二階段構成競賽。第三階段則是發表結果的研討會。
      </p>
    </div>

    <!-- ── Three-Phase Pipeline ── -->
    <div class="pipeline-wrap fade-in" aria-label="三階段基準流程">
      <div class="pipeline">

        <!-- Phase I -->
        <div class="pipeline-phase">
          <div class="phase-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 56 56" fill="none" aria-hidden="true">
              <rect x="4" y="8" width="48" height="32" rx="4" stroke="currentColor" stroke-width="3"/>
              <path d="M20 46h16M28 40v6" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              <path d="M16 22l6 6-6 6M30 34h6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="phase-label">第一階段</div>
          <h3 class="phase-title">開放模擬基準</h3>
          <p class="phase-desc">
            釋出開放的模擬基準，著重於非結構化的操作情境：纜線佈線與插接、可變形物體操作（導熱墊放置），以及輔助生活與餵食任務。全球隊伍透過公開招募，於共享且可重現的排行榜上參賽。
          </p>
        </div>

        <!-- Arrow I → II -->
        <div class="pipeline-arrow" aria-hidden="true">
          <svg viewBox="0 0 48 24" xmlns="http://www.w3.org/2000/svg">
            <path class="arrow-line" d="M4 12 H38" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
