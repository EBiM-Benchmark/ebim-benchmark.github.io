<!-- ============================================================
     REGISTER — state-gated on site.openDayMunichRegistration
     ("open" → live RSVP form | "waitlist" → form + banner + list=waitlist
      | "closed" → no form, closed panel). See _data/site.json.
     This is the MUNICH key; site.openDayRegistration is Hamburg's and is not
     read here. The two days run on independent flags.
     ============================================================ -->
<section id="register">
  <div class="container">
    <div class="text-center fade-in">
      <h2 class="section-title">報名</h2>
    </div>

{%- if site.openDayMunichRegistration == "closed" %}

    <div class="od-closed fade-in">
      <div class="od-closed-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <h3>慕尼黑開放日的報名已截止。</h3>
      <p>如對本次活動有任何疑問，請<a href="{{ links.contact }}">與我們聯絡</a>。</p>
    </div>

{%- else %}

    <div class="od-notice fade-in">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
      <span>免費參加。接駁車共有 60 個名額，依報名先後順序分配——若您報名時接駁車已額滿，仍非常歡迎您參加演講與晚餐。報名將持續開放至 2026 年 9 月 10 日（週四）活動開始為止。請在出發前完成報名——現場恕不接受未報名者入場。名額以電子郵件確認為準；送出表單並不代表已取得名額。</span>
    </div>

    <div class="reg-card fade-in">

{%- if site.openDayMunichRegistration == "waitlist" %}
      <div class="od-waitlist">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span>接駁車的 60 個名額已全數額滿。您仍可報名參加演講與晚餐；如有名額釋出，我們會以電子郵件通知您。</span>
      </div>
{%- endif %}

      <!-- Native Web3Forms RSVP form. AJAX-first (see open-day-form-script.njk);
           hCaptcha is enabled on this key and enforced server-side, so JS is required to submit. -->
      <form id="openDayForm" action="https://api.web3forms.com/submit" method="POST"
            data-msg-referral="請至少選擇一種得知開放日的管道（或填寫「其他」）。"
            data-msg-captcha="請先完成人機驗證再送出。"
            data-msg-generic="發生錯誤，請再試一次。"
            data-msg-network="網路錯誤，請稍後再試。"
            data-sending="送出中⋯⋯"
            data-submit-label="送出報名">

        <div class="reg-form">

          <div class="form-field">
            <label class="form-label" for="full_name">姓名（須與您的附照片證件一致） <span class="req" aria-hidden="true">*</span>
              <span class="form-label-note">櫃檯將據此核對您的證件</span></label>
            <input class="form-input" type="text" id="full_name" name="full_name" maxlength="120" required placeholder="您的全名" />
          </div>

          <div class="form-field">
            <label class="form-label" for="email">Email <span class="req" aria-hidden="true">*</span>
              <span class="form-label-note">確認信將寄送至此信箱</span></label>
            <input class="form-input" type="email" id="email" name="email" maxlength="200" required placeholder="you@example.org" />
          </div>

          <div class="form-field">
            <label class="form-label" for="affiliation">所屬單位（學校 / 公司） <span class="req" aria-hidden="true">*</span></label>
            <input class="form-input" type="text" id="affiliation" name="affiliation" maxlength="200" required placeholder="例如：慕尼黑工業大學" />
          </div>

          <div class="form-field">
            <label class="form-label" for="country">國家或地區 <span class="req" aria-hidden="true">*</span></label>
            <input class="form-input" type="text" id="country" name="country" maxlength="120" required placeholder="例如：德國" />
          </div>

          <fieldset class="form-field">
            <legend class="form-label">您將如何參加上午的參訪？ <span class="req" aria-hidden="true">*</span></legend>
            <div class="od-radios">
              <label class="reg-check"><input type="radio" name="site_visit" value="Shuttle from Munich Hbf (10:00)" required /> <span>搭乘從慕尼黑中央車站出發的接駁車（10:00）</span></label>
              <label class="reg-check"><input type="radio" name="site_visit" value="Shuttle from Agile Robots SE (10:30)" /> <span>搭乘從 Agile Robots SE 出發的接駁車（10:30）</span></label>
              <label class="reg-check"><input type="radio" name="site_visit" value="I'll skip the site visit and come for the talks" /> <span>我不參加參訪，直接前來參加演講</span></label>
            </div>
          </fieldset>

          <fieldset class="form-field">
            <legend class="form-label">您是否會留下來參加在 Agile Robots SE 的晚餐？ <span class="req" aria-hidden="true">*</span>
              <span class="form-label-note">由 Agile Robots 招待，18:30 開始</span></legend>
            <div class="od-radios">
              <label class="reg-check"><input type="radio" name="dinner" value="Yes" required /> <span>是</span></label>
              <label class="reg-check"><input type="radio" name="dinner" value="No" /> <span>否</span></label>
            </div>
          </fieldset>

          <div class="form-field">
            <label class="form-label" for="dietary">飲食需求 <span class="form-label-note">（選填——午餐與晚餐皆由主辦單位招待）</span></label>
            <input class="form-input" type="text" id="dietary" name="dietary" maxlength="200" placeholder="例如：素食、堅果過敏" />
          </div>

          <fieldset class="form-field">
            <legend class="form-label">您從哪裡得知本次開放日？ <span class="req" aria-hidden="true">*</span></legend>
            <div class="reg-checks">
              <label class="reg-check"><input type="checkbox" name="referral" value="Discord" /> <span>Discord</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="WeChat" /> <span>微信</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="Colleague or word of mouth" /> <span>同事或口耳相傳</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="X (Twitter)" /> <span>X（推特）</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="LinkedIn" /> <span>LinkedIn</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="Mailing list" /> <span>郵寄名單</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="Search engine" /> <span>搜尋引擎</span></label>
              <label class="reg-check"><input type="checkbox" name="referral" value="The EBiM website" /> <span>EBiM 官方網站</span></label>
            </div>
            <input class="form-input reg-check-other" type="text" name="referral_other" maxlength="200" placeholder="其他（請註明）" />
          </fieldset>

          <!-- ── Consent ── -->
          <div class="form-field">
            <div class="reg-checks">
              <label class="reg-check">
                <input type="checkbox" name="consent_guestlist" value="Yes" required />
                <span>我同意將我的姓名與所屬單位提供給 Agile Robots SE，以辦理大樓門禁登記。（必填——場地無法接待未列入名單的來賓。） <span class="req" aria-hidden="true">*</span></span>
              </label>
              <label class="reg-check">
                <input type="checkbox" name="consent_media_notice" value="Yes" required />
                <span>我了解本次活動將進行拍照與錄影，相關影像可能由 EBiM 主辦單位及合作夥伴公開發布。 <span class="req" aria-hidden="true">*</span></span>
              </label>
              <label class="reg-check">
                <input type="checkbox" name="media_optout" value="Yes" />
