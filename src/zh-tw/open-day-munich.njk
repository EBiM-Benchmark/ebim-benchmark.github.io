            </div>
          </div>

          <!-- Hidden Web3Forms fields -->
          <input type="hidden" name="access_key" value="c4af1beb-1263-4551-ba15-86647ce43ddb" />
          <input type="hidden" name="from_name" value="EBiM Benchmark — Open Day Munich" />
          <input type="hidden" name="subject" value="[OPEN DAY MUNICH] New registration" />
          <input type="hidden" name="redirect" value="https://ebim-benchmark.github.io/zh-tw/open-day-munich-success.html" />
{%- if site.openDayMunichRegistration == "waitlist" %}
