{% block headStyle %}{% raw %}
  <style>
    .fade-in { opacity: 0; transform: translateY(20px); transition: opacity .55s ease, transform .55s ease; }
    .fade-in.visible { opacity: 1; transform: none; }

    /* Active nav link for the current page (Open Day → the hub) */
    .page-open-day .nav-links a[href="open-day.html"] { color: var(--accent); font-weight: 700; }

    /* Back to top */
    #back-to-top {
      position: fixed; bottom: 2rem; right: 1.5rem; width: 44px; height: 44px; border-radius: 50%;
      background: var(--accent, #00d4ff); color: #0a0e1a; border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden; transform: translateY(12px);
      transition: opacity .3s, visibility .3s, transform .3s, background .2s, box-shadow .2s;
      z-index: 998; box-shadow: 0 4px 18px rgba(0,212,255,.35);
    }
    #back-to-top.visible { opacity: 1; visibility: visible; transform: none; }
    #back-to-top:hover { background: #fff; box-shadow: 0 6px 24px rgba(0,212,255,.45); }
    #back-to-top:focus-visible { outline: 2px solid #00d4ff; outline-offset: 3px; }
    #back-to-top svg { pointer-events: none; }

    /* ── Sub-page hero (copied from open-day-hamburg.njk) ── */
    #home.subhero {
      min-height: 32vh; display: flex; align-items: center; justify-content: center;
      position: relative; background: var(--bg-dark); overflow: hidden;
      padding: calc(var(--nav-h) + 2.5rem) 0 3rem; box-sizing: border-box;
    }
    #home.subhero::before {
      content: ''; position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,212,255,.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,212,255,.07) 1px, transparent 1px);
      background-size: 60px 60px; pointer-events: none;
    }
    #home.subhero::after {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(0,212,255,.10) 0%, transparent 70%);
      pointer-events: none;
    }
    .subhero-content { position: relative; z-index: 1; text-align: center; max-width: 820px; padding: 1.25rem 1.5rem; }
    .breadcrumb { display: inline-block; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.55); margin-bottom: 1rem; }
    .breadcrumb a { color: rgba(255,255,255,.55); transition: color .2s; }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb-sep { margin: 0 .55rem; opacity: .5; }
    .breadcrumb-current { color: var(--accent); }
    .subhero-title { font-size: clamp(1.7rem, 3.6vw, 2.6rem); color: #fff; font-weight: 800; line-height: 1.18; margin-bottom: .9rem; letter-spacing: -.01em; }
    .subhero-subtitle { font-size: clamp(.95rem, 1.6vw, 1.1rem); color: rgba(255,255,255,.72); margin-bottom: .8rem; max-width: 660px; margin-left: auto; margin-right: auto; }
    .subhero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 1.4rem; }
    @media (max-width: 700px) { #home.subhero { min-height: 46vh; padding-top: calc(var(--nav-h) + 1.5rem); padding-bottom: 2rem; } }

    /* Hero eyebrow + fact line. Unlike open-day-hamburg.njk the eyebrow forces
       its OWN line: the pill is shrink-to-fit and the breadcrumb above it is
       inline-block, so a SHORT eyebrow ("Open Day · Shanghai") rides up beside
       the breadcrumb and renders the label twice on one cramped line. Hamburg
       only escapes that because its eyebrow text is long enough to wrap on its
       own. block + max-content keeps the pill hugging its text AND breaks the line. */
    .od-eyebrow {
      display: block; width: max-content; max-width: 100%;
      margin: 0 auto 1rem; padding: .3rem .9rem; border-radius: 100px;
      background: rgba(0,212,255,.10); border: 1px solid rgba(0,212,255,.35);
      font-size: .76rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent);
    }
    .od-hero-meta { font-size: .95rem; font-weight: 600; color: rgba(255,255,255,.9); margin-bottom: .9rem; }

    /* Invitation notice — this day has no public registration form */
    .od-notice {
      display: flex; align-items: flex-start; gap: .65rem; max-width: 860px; margin: 2.5rem auto 0;
      background: rgba(0,212,255,.06); border: 1px solid rgba(0,212,255,.28); border-radius: 12px;
      padding: 1rem 1.2rem; font-size: .95rem; color: var(--text-mid); line-height: 1.65;
    }
    .od-notice svg { flex-shrink: 0; margin-top: .15rem; color: var(--accent-dark); }

    /* Clarifier callout — this is NOT the Phase III workshop */
    .od-callout {
      display: flex; align-items: flex-start; gap: .7rem; max-width: 860px; margin: 1.5rem auto 0;
      background: rgba(245,158,11,.07); border: 1px solid rgba(245,158,11,.32); border-radius: 12px;
      padding: 1rem 1.2rem; font-size: .92rem; color: var(--text-mid); line-height: 1.6;
    }
    .od-callout svg { flex-shrink: 0; margin-top: .15rem; color: #b45309; }

    /* ── #program — schedule note + speaker cards (sched-* / talk-card conventions) ── */
    .od-sched-note { max-width: 860px; margin: 1.25rem auto 0; text-align: center; font-size: .85rem; color: var(--text-muted); line-height: 1.6; }
    .talks-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem; margin-top: 2.5rem;
    }
    .talk-card {
      background: #fff; border: 1px solid rgba(10,14,26,.08); border-radius: 14px;
      padding: 1.6rem 1.25rem 1.4rem; text-align: center;
      transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
      display: flex; flex-direction: column; align-items: center;
    }
    .talk-card:hover { transform: translateY(-4px); border-color: rgba(0,212,255,.45); box-shadow: 0 10px 30px rgba(10,14,26,.08); }
    .talk-card .org-avatar, .talk-card .org-photo { margin-bottom: .9rem; }
    .talk-speaker-name { font-size: 1.02rem; font-weight: 800; color: var(--bg-dark); margin-bottom: .25rem; }
    .talk-speaker-affil { font-size: .82rem; color: var(--text-muted); margin-bottom: .9rem; line-height: 1.4; }
    .talk-title { font-size: .95rem; font-weight: 600; line-height: 1.5; color: var(--accent-dark); font-style: italic; margin-top: auto; }
    .od-speakers-head { max-width: 860px; margin: 3.5rem auto 0; text-align: center; }
    .od-speakers-head h3 { font-size: 1.3rem; font-weight: 800; color: var(--bg-dark); }

    /* ── #venue ── */
    .od-venue-card {
      max-width: 860px; margin: 2.5rem auto 0; background: var(--bg-white); border: 1px solid var(--border);
      border-radius: 16px; padding: 2rem 2rem; box-shadow: var(--card-shadow);
    }
    .od-venue-list { display: flex; flex-direction: column; gap: 1.1rem; }
    .od-venue-item { display: flex; align-items: flex-start; gap: .8rem; font-size: .95rem; line-height: 1.65; color: var(--text-mid); }
    .od-venue-item svg { flex-shrink: 0; margin-top: .2rem; color: var(--accent-dark); }
    .od-venue-item strong { color: var(--text-dark); }
    /* The address in Chinese, rendered on BOTH locales: an English transliteration is
       not enough to reach the building by taxi or ride-hailing app in Shanghai. */
    .od-venue-zh { display: block; margin-top: .35rem; font-weight: 600; color: var(--text-dark); }
    @media (max-width: 540px) { .od-venue-card { padding: 1.5rem 1.25rem; } }

